    settingsGpuPassPrepBtn.disabled = false;
  }
}

async function createVgpuMdev() {
  const gpuPciId = (settingsGpuPassVgpuPciId?.value || '').trim();
  const profile = (settingsGpuPassVgpuProfile?.value || '').trim();
  const count = parseInt(settingsGpuPassVgpuCount?.value || '1', 10) || 1;
  if (!gpuPciId || !profile) { setGpuPassStatus('PCI ID and profile required.'); return; }
  if (!confirm(`Create ${count} vGPU mdev instance(s) on ${gpuPciId} using profile '${profile}'?\n\nThe host must already be in vgpu mode. Without an active NVIDIA vGPU license server, this call will fail at the cluster layer.`)) {
