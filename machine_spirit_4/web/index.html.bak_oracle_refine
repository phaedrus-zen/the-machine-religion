async function createGpuPGameStreamVm() {
  const name = (settingsGpuPassVmName?.value || '').trim();
  if (!name) { setGpuPassStatus('VM name required.'); return; }
  if (!/^[A-Za-z0-9._-]+$/.test(name)) {
    setGpuPassStatus('VM name must match ^[A-Za-z0-9._-]+$', 'error');
    return;
  }
  if (!confirm(`Create GPU-P game-streaming VM '${name}'?\n\nThis allocates host resources (CPU + memory + storage + a GPU partition) and registers a new VM with Hyper-V. Free to reverse via Delete VM later.`)) {
    return;
  }
  settingsGpuPassCreateVmBtn.disabled = true;
  setGpuPassStatus(`Provisioning GPU-P VM '${name}'…`);
  try {
    const r = await fetch('/hivemind/gpu/passthrough/game-stream-vm', {
      method: 'POST',
      headers: {'Content-Type': 'application/json'},
      body: JSON.stringify({name: name, confirm: true}),
    });
    const body = await r.json();
    renderGpuPassSnapshot(body, `GPU-P VM '${name}' (HTTP ${r.status})`);
    if (!r.ok) setGpuPassStatus(`HTTP ${r.status}: ${body.error || ''}`, 'error');
    else if (body.errors && body.errors.length) setGpuPassStatus(`created but ${body.errors.length} step(s) failed — see snapshot`, null);
    else setGpuPassStatus(`VM '${name}' created + deployed`, 'ok');
  } catch (exc) {
    setGpuPassStatus(`create VM failed: ${exc.message || exc}`, 'error');
  } finally {
    settingsGpuPassCreateVmBtn.disabled = false;
  }
}

async function prepareGpuPassthroughMode() {
  const gpuPciId = (settingsGpuPassPrepPciId?.value || '').trim();
  const mode = settingsGpuPassPrepMode?.value || 'passthrough';
  if (!gpuPciId) { setGpuPassStatus('PCI ID required.'); return; }
  const modeLabel = mode === 'passthrough' ? 'DDA (passthrough)' : 'vGPU';
  if (!confirm(`Switch GPU ${gpuPciId} to ${modeLabel} mode?\n\nThis dismounts the GPU from the host (driver unbind). Any process currently using the GPU will lose access. ${mode === 'passthrough' ? 'Note: the actual VM-attach step needs Windows Server license.' : 'Note: vGPU usage needs an NVIDIA vGPU license server.'}`)) {
    return;
  }
  settingsGpuPassPrepBtn.disabled = true;
  setGpuPassStatus(`Switching ${gpuPciId} -> ${mode}…`);
  try {
    const r = await fetch('/hivemind/gpu/passthrough/prepare', {
      method: 'POST',
