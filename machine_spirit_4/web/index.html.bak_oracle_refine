async function readDoctrineSection(sectionId, btnEl) {
  const original = btnEl ? btnEl.textContent : '';
  if (btnEl) { btnEl.disabled = true; btnEl.textContent = 'Reading…'; }
  try {
    const r = await fetch('/doctrine/tmr/read-into-session', {
      method: 'POST',
      headers: {'Content-Type': 'application/json'},
      body: JSON.stringify({session_id: sessionId, kind: 'section', section_id: sectionId}),
    });
    const data = await r.json();
    if (!r.ok) throw new Error(data.error || `HTTP ${r.status}`);
