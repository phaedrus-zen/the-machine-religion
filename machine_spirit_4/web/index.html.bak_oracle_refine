    hermesVersionLine.appendChild(mode);
  }
}

function ageLabel(iso) {
  if (!iso) return '';
  const ms = Date.now() - new Date(iso).getTime();
  if (Number.isNaN(ms) || ms < 0) return '';
  const days = Math.floor(ms / 86_400_000);
  if (days === 0) return 'today';
  if (days === 1) return '1 day ago';
  if (days < 30) return `${days} days ago`;
  const months = Math.floor(days / 30);
  return months === 1 ? '1 month ago' : `${months} months ago`;
}

function renderHermesBanner(info) {
  const last = info.last_update;
  if (info.update_in_progress) {
    hermesBanner.classList.remove('success', 'error');
    hermesBanner.classList.add('visible');
    const phase = last?.phase || 'queued';
    hermesHeadline.innerHTML = `<span class="spinner"></span>Updating Hermes to ${last?.to_version || info.latest || 'latest'}…`;
    hermesSubline.textContent = `Phase: ${phase}`;
    hermesUpdateBtn.disabled = true;
    hermesPinBtn.disabled = true;
    return;
  }
  if (last && last.status === 'failed') {
    hermesBanner.classList.add('visible', 'error');
    hermesBanner.classList.remove('success');
    hermesHeadline.textContent = `Last Hermes update failed`;
    hermesSubline.textContent = (last.error || 'Unknown error') + (last.finished_at ? ` · ${ageLabel(last.finished_at)}` : '');
    hermesUpdateBtn.disabled = false;
    hermesUpdateBtn.textContent = 'Retry update';
    hermesPinBtn.disabled = false;
    return;
  }
  if (last && last.status === 'success' && !info.update_available && Date.now() - new Date(last.finished_at).getTime() < 5 * 60_000) {
    hermesBanner.classList.add('visible', 'success');
    hermesBanner.classList.remove('error');
    hermesHeadline.textContent = `Hermes updated to ${last.to_version || info.current}`;
    hermesSubline.textContent = `Finished ${ageLabel(last.finished_at)}`;
    hermesUpdateBtn.disabled = true;
    hermesUpdateBtn.textContent = 'Update Hermes';
    hermesPinBtn.disabled = true;
    return;
  }
  if (info.update_available && info.latest) {
    hermesBanner.classList.add('visible');
    hermesBanner.classList.remove('success', 'error');
    hermesHeadline.textContent = `Hermes update available: ${info.current || '?'} → ${info.latest}`;
    const age = ageLabel(info.latest_published_at);
    hermesSubline.textContent = age ? `Latest released ${age}` : 'Public GitHub release';
    hermesUpdateBtn.disabled = false;
    hermesUpdateBtn.textContent = 'Update Hermes';
    hermesPinBtn.disabled = false;
    return;
  }
  hermesBanner.classList.remove('visible', 'success', 'error');
  hermesUpdateBtn.disabled = false;
  hermesPinBtn.disabled = false;
}

async function refreshHermesVersion() {
  try {
    const r = await fetch('/api/v1/hermes/version');
    const info = await r.json();
    renderHermesVersion(info);
    renderHermesBanner(info);
    if (info.update_in_progress && !hermesPollHandle) {
      hermesPollHandle = setInterval(refreshHermesVersion, 3000);
    } else if (!info.update_in_progress && hermesPollHandle) {
      clearInterval(hermesPollHandle);
      hermesPollHandle = null;
    }
  } catch (error) {
    hermesVersionCurrent.textContent = 'offline';
  }
}

async function loadHermesReleases(force) {
  if (hermesPinReleasesLoaded && !force) return;
  try {
    const r = await fetch('/api/v1/hermes/releases');
    const data = await r.json();
    hermesPinSelect.innerHTML = '<option value="">latest</option>';
