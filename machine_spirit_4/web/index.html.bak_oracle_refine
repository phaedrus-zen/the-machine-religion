async function vmAction(vmId, action, opts) {
  opts = opts || {};
  if (opts.confirmText && !window.confirm(opts.confirmText)) return;
  if (settingsHivemindVmsStatus) settingsHivemindVmsStatus.textContent = `${action} ${vmId}…`;
  if (action === 'screenshot') {
    try {
      const r = await fetch(`/hivemind/vms/${encodeURIComponent(vmId)}/screenshot`, {cache: 'no-store'});
      if (!r.ok) throw new Error(`HTTP ${r.status}: ${await r.text()}`);
      const body = await r.json();
      // New shape (Ms4VmScreenshot.v1, May 26 2026): {image_base64, mime_type, metadata}.
      // Backward-compatible: also accept the legacy {data_base64, format} or
      // a metadata-only response.
      const data = body.image_base64
        || body.data_base64
        || (body.metadata && (body.metadata.data_base64 || body.metadata.image_base64))
        || body.base64;
      const mime = body.mime_type
        || (body.format ? `image/${body.format}` : null)
        || (body.metadata && body.metadata.format ? `image/${body.metadata.format}` : 'image/png');
      if (!data) throw new Error('no screenshot payload');
      const win = window.open('', '_blank');
      if (win) {
        win.document.write(`<title>VM ${vmId} screenshot</title><img src="data:${mime};base64,${data}" style="max-width:100%;">`);
      }
      if (settingsHivemindVmsStatus) settingsHivemindVmsStatus.textContent = `screenshot for ${vmId} opened`;
    } catch (exc) {
      if (settingsHivemindVmsStatus) settingsHivemindVmsStatus.textContent = `screenshot failed: ${exc.message || exc}`;
    }
    return;
  }
  try {
    const body = (action === 'force_stop' || action === 'delete') ? {confirm: true} : {};
    const r = await fetch(`/hivemind/vms/${encodeURIComponent(vmId)}/${action}`, {
      method: 'POST',
      headers: {'Content-Type': 'application/json'},
      body: JSON.stringify(body),
    });
    if (!r.ok) throw new Error(`HTTP ${r.status}: ${await r.text()}`);
    if (settingsHivemindVmsStatus) settingsHivemindVmsStatus.textContent = `${action} ${vmId} OK`;
    await refreshHivemindVms();
  } catch (exc) {
    if (settingsHivemindVmsStatus) settingsHivemindVmsStatus.textContent = `${action} failed: ${exc.message || exc}`;
  }
}

