    row.appendChild(t);
  }
  if (data.reply_text_preview) {
    const t = document.createElement('div'); t.style.color = '#9999b4';
    t.textContent = `↪ ${data.reply_text_preview}${data.reply_text_chars > 200 ? '…' : ''} (${data.reply_text_chars}c)`;
    row.appendChild(t);
  }
  if (data.error) {
    const t = document.createElement('div'); t.style.color = '#ef4444';
    t.textContent = `error: ${data.error}`;
    row.appendChild(t);
  }
  // Metric grid
  const grid = document.createElement('div');
  grid.style.cssText = 'display:grid; grid-template-columns: repeat(4, 1fr); gap:4px; font-size:10px; color:#9999b4; margin-top:2px;';
  const cells = [
    ['asr', fmtMs(data.asr_ms)],
    ['chat', fmtMs(data.chat_ms)],
    ['first text', fmtMs(data.first_text_token_ms)],
    ['first audio', fmtMs(data.first_audio_chunk_ms)],
    ['chunks', String(data.audio_chunks ?? '?')],
    ['parallel ×', data.tts_parallelism_speedup != null ? data.tts_parallelism_speedup.toFixed(2) : '?'],
    ['max held', fmtMs(data.max_held_for_inorder_ms)],
