// The approval banner appears whenever a pending approval is known.
// We don't have a list-pending endpoint on HiveMind yet, so the
// in-Settings input lets the operator paste a request ID to poll.
// When MS4-side flows fire approvals (e.g. risky desktop_action), we
// push the request_id into ``pendingApprovals`` and the banner cycles
// through them.

const approvalBanner = document.getElementById('approvalBanner');
const approvalHeadline = document.getElementById('approvalBannerHeadline');
const approvalSubline = document.getElementById('approvalBannerSubline');
const approvalApproveBtn = document.getElementById('approvalBannerApprove');
const approvalRejectBtn = document.getElementById('approvalBannerReject');
const approvalDismissBtn = document.getElementById('approvalBannerDismiss');
const settingsApprovalQueue = document.getElementById('settingsApprovalQueue');
const settingsApprovalRequestId = document.getElementById('settingsApprovalRequestId');
const settingsApprovalCheck = document.getElementById('settingsApprovalCheck');
const settingsApprovalStatus = document.getElementById('settingsApprovalStatus');

const pendingApprovals = new Map(); // request_id -> {summary, headline}
let approvalDismissed = false;

function showApprovalBanner() {
  if (approvalDismissed || pendingApprovals.size === 0) {
    approvalBanner.style.display = 'none';
    return;
  }
  const [requestId, info] = pendingApprovals.entries().next().value;
  approvalHeadline.textContent = info.headline || 'Approval requested';
  approvalSubline.textContent = `${info.summary || ''} (${requestId})`;
  approvalBanner.style.display = '';
  approvalApproveBtn.onclick = () => respondApproval(requestId, 'approve');
  approvalRejectBtn.onclick = () => respondApproval(requestId, 'reject');
  approvalDismissBtn.onclick = () => { approvalDismissed = true; approvalBanner.style.display = 'none'; };
}

async function respondApproval(requestId, decision) {
  // HiveMind's request -> Telegram/etc. is what actually drives the
  // decision; we mark our local pendingApprovals as resolved.
  pendingApprovals.delete(requestId);
  approvalDismissed = false;
  showApprovalBanner();
  await refreshApprovalQueue();
}

async function checkApprovalStatus(requestId) {
  if (!requestId) return;
  settingsApprovalStatus.textContent = `Polling ${requestId}…`;
  try {
    const r = await fetch(`/hivemind/approval/status/${encodeURIComponent(requestId)}`, {cache: 'no-store'});
    if (!r.ok) throw new Error(`HTTP ${r.status}: ${await r.text()}`);
    const body = await r.json();
    const decision = (body.decision || '').toLowerCase();
    settingsApprovalStatus.textContent = `${requestId}: ${decision || 'unknown'}`;
    if (decision === 'pending') {
      pendingApprovals.set(requestId, {summary: body.summary || '(no summary)', headline: 'Approval pending'});
    } else {
      pendingApprovals.delete(requestId);
    }
    showApprovalBanner();
    await refreshApprovalQueue();
  } catch (exc) {
    settingsApprovalStatus.textContent = `status check failed: ${exc.message || exc}`;
  }
}

async function refreshApprovalQueue() {
  if (!settingsApprovalQueue) return;
  if (pendingApprovals.size === 0) {
    settingsApprovalQueue.textContent = 'No pending approvals.';
    return;
  }
  settingsApprovalQueue.innerHTML = '';
  for (const [requestId, info] of pendingApprovals.entries()) {
    const row = document.createElement('div');
    row.style.cssText = 'display:flex; align-items:center; gap:6px; padding:6px; border-bottom:1px solid #22243a;';
    const idEl = document.createElement('code'); idEl.style.minWidth = '180px'; idEl.textContent = requestId;
    const summary = document.createElement('span'); summary.style.flex = '1'; summary.textContent = info.summary || '';
    const recheck = document.createElement('button'); recheck.type = 'button'; recheck.className = 'secondary';
    recheck.style.fontSize = '11px'; recheck.textContent = 'Re-check';
    recheck.addEventListener('click', () => checkApprovalStatus(requestId));
    row.appendChild(idEl); row.appendChild(summary); row.appendChild(recheck);
    settingsApprovalQueue.appendChild(row);
  }
}

if (settingsApprovalCheck) {
  settingsApprovalCheck.addEventListener('click', () => {
    const id = (settingsApprovalRequestId.value || '').trim();
    if (id) checkApprovalStatus(id);
  });
}

