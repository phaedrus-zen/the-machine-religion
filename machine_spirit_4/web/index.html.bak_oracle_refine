  if (data.audio_errors) {
    const ae = document.createElement('span'); ae.className = 'pill';
    ae.style.color = '#ef4444'; ae.style.borderColor = '#ef4444';
    ae.textContent = `${data.audio_errors} audio err`;
    header.appendChild(ae);
  }
  if (turn?.timestamp) {
    const ts = document.createElement('span'); ts.className = 'muted'; ts.style.fontSize = '10px';
    ts.style.marginLeft = 'auto';
    ts.textContent = String(turn.timestamp).slice(0, 19).replace('T', ' ');
