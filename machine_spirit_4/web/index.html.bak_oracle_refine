async function enrollVoiceIdentity() {
  const name = (settingsVoiceIdentityName.value || '').trim();
  if (!name) {
    settingsVoiceIdentityStatus.textContent = 'Type a speaker name first.';
    return;
  }
  settingsVoiceIdentityEnroll.disabled = true;
  settingsVoiceIdentityStatus.textContent = `Recording ${VOICE_ENROLL_SECS}s — keep talking continuously (read a sentence or two, don't pause)…`;
  let stream;
  try {
    stream = await acquireMicStream();
  } catch (exc) {
    settingsVoiceIdentityStatus.textContent = micErrorMessage(exc);
    settingsVoiceIdentityEnroll.disabled = false;
    return;
  }
  const ctx = new (window.AudioContext || window.webkitAudioContext)();
  if (ctx.state === 'suspended') await ctx.resume();
  const src = ctx.createMediaStreamSource(stream);
  const proc = ctx.createScriptProcessor(4096, 1, 1);
  const chunks = [];
  proc.onaudioprocess = e => chunks.push(new Float32Array(e.inputBuffer.getChannelData(0)));
  src.connect(proc);
  const silent = ctx.createGain(); silent.gain.value = 0; proc.connect(silent); silent.connect(ctx.destination);
  await new Promise(res => setTimeout(res, VOICE_ENROLL_SECS * 1000));
  proc.disconnect(); src.disconnect();
  stream.getTracks().forEach(t => { try { t.stop(); } catch (e) {} });
  await ctx.close();
  settingsVoiceIdentityStatus.textContent = `Encoding + uploading enrollment for "${name}"…`;
  try {
    const samples = concatenateFloat32(chunks);
    const downsampled = downsampleTo(samples, ctx.sampleRate, TARGET_SAMPLE_RATE);
    const wav = encodeWavBlob(downsampled, TARGET_SAMPLE_RATE);
    const buf = await wav.arrayBuffer();
    let bin = '';
    const bytes = new Uint8Array(buf);
    for (let i = 0; i < bytes.length; i++) bin += String.fromCharCode(bytes[i]);
    const audio_base64 = btoa(bin);
    const r = await fetch('/hivemind/voice_identities/enroll', {
      method: 'POST',
      headers: {'Content-Type': 'application/json'},
      body: JSON.stringify({name, audio_base64}),
    });
    if (!r.ok) throw new Error(`HTTP ${r.status}: ${await r.text()}`);
    settingsVoiceIdentityStatus.textContent = `Enrolled "${name}".`;
    settingsVoiceIdentityName.value = '';
    await refreshVoiceIdentities();
  } catch (exc) {
    settingsVoiceIdentityStatus.textContent = `Enroll failed: ${exc.message || exc}`;
  } finally {
    settingsVoiceIdentityEnroll.disabled = false;
  }
}
if (settingsVoiceIdentityEnroll) settingsVoiceIdentityEnroll.addEventListener('click', enrollVoiceIdentity);

