async function triggerVoiceServiceProvision(service, btnEl) {
  const original = btnEl ? btnEl.textContent : '';
  if (btnEl) { btnEl.disabled = true; btnEl.textContent = 'Requesting…'; }
  try {
    const r = await fetch(`/voice/services/${encodeURIComponent(service)}/provision`, {
      method: 'POST',
      headers: {'Content-Type': 'application/json'},
      body: JSON.stringify({}),
    });
    const ack = await r.json();
    if (!r.ok && r.status !== 202) throw new Error(ack.error || `HTTP ${r.status}`);
    setVoiceStatus(`${service}: provisioning requested (provision_id=${(ack.result || {}).provision_id || 'n/a'})`, null);
    renderOracleVoiceReadiness({
      voice_input_ready: false,
      asr: {service: String(service || 'ASR').toUpperCase(), provisioning_state: 'provisioning', detail: 'Provisioning requested'},
    });
    // Start a short polling burst so the dialog and the top-bar
    // voice pill update without the operator hitting refresh.
    if (voiceServicesPollHandle) clearInterval(voiceServicesPollHandle);
    let polls = 0;
    voiceServicesPollHandle = setInterval(async () => {
      polls += 1;
      const data = await refreshVoiceServices();
      const svc = (data?.services || []).find(s => s.service === service.toUpperCase());
      if (svc?.healthy || polls > 80) {  // 80 polls ~ 2 minutes at 1.5s
        clearInterval(voiceServicesPollHandle);
        voiceServicesPollHandle = null;
        if (svc?.healthy) setVoiceStatus(`${service}: healthy`, 'ok');
      }
    }, 1500);
  } catch (exc) {
    setVoiceStatus(`${service} provision failed: ${exc.message || exc}`, 'error');
  } finally {
    if (btnEl) { btnEl.disabled = false; btnEl.textContent = original; }
  }
}

async function triggerVoiceServiceRelease(service, btnEl) {
  const original = btnEl ? btnEl.textContent : '';
  if (btnEl) { btnEl.disabled = true; btnEl.textContent = 'Releasing…'; }
  try {
    const r = await fetch(`/voice/services/${encodeURIComponent(service)}/release`, {
      method: 'POST',
      headers: {'Content-Type': 'application/json'},
      body: JSON.stringify({}),
    });
    const ack = await r.json();
    if (!r.ok) throw new Error(ack.error || `HTTP ${r.status}`);
    setVoiceStatus(`${service}: release requested`, null);
    await refreshVoiceServices();
  } catch (exc) {
    setVoiceStatus(`${service} release failed: ${exc.message || exc}`, 'error');
  } finally {
    if (btnEl) { btnEl.disabled = false; btnEl.textContent = original; }
  }
}

