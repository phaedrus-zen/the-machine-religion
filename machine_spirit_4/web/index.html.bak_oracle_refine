// ----- Reflex audio (pre-rendered canned phrases) --------------------
//
// On page load, fetch /reflexes and pre-decode every available WAV
// into an in-memory AudioBuffer. playReflex(id) then schedules
// playback in ~5ms — no HiveMind round-trip, no SSE. Used for
// barge-in acks (when MS4_REFLEX_BARGE_ACK toggle is on), chat
// failure fallbacks, and latency cover during cold loads.

const REFLEX_BARGE_ACK_KEY = 'ms4_reflex_barge_ack';
const reflexBuffers = new Map();   // id -> AudioBuffer
const reflexMetaById = new Map();  // id -> {id, text, category, ...}

async function preloadReflex(reflex) {
  if (!reflex || !reflex.available) return;
  try {
    const r = await fetch(reflex.url, {cache: 'force-cache'});
    if (!r.ok) return;
    const bytes = await r.arrayBuffer();
    const ctx = getPlaybackCtx();
    const buffer = await ctx.decodeAudioData(bytes);
    reflexBuffers.set(reflex.id, buffer);
  } catch (exc) {
    console.warn('reflex preload failed:', reflex?.id, exc);
  }
}

async function refreshReflexCatalog() {
  const root = document.getElementById('settingsReflexCatalog');
  const status = document.getElementById('settingsReflexStatus');
  if (root) root.innerHTML = '<div class="muted">Loading…</div>';
  try {
    const r = await fetch('/reflexes', {cache: 'no-store'});
    if (!r.ok) throw new Error(`HTTP ${r.status}`);
    const data = await r.json();
    reflexMetaById.clear();
    (data.reflexes || []).forEach(rfx => reflexMetaById.set(rfx.id, rfx));
    // Preload available reflexes in parallel; missing ones just stay
    // out of the buffer map and playReflex falls back to silence.
    await Promise.all((data.reflexes || []).filter(r => r.available).map(preloadReflex));
    if (status) status.textContent = `voice=${data.voice} · ${data.available}/${data.total} available · ${(data.total_bytes/1024).toFixed(1)} KiB cached`;
    if (root) root.innerHTML = '';
    (data.reflexes || []).forEach(rfx => root && root.appendChild(renderReflexRow(rfx)));
    return data;
  } catch (exc) {
    if (root) root.innerHTML = `<div class="muted">/reflexes failed: ${exc.message || exc}</div>`;
    return null;
  }
}

function renderReflexRow(rfx) {
  const row = document.createElement('div');
  row.style.cssText = 'display:flex; align-items:center; gap:8px; padding:4px 6px; border-bottom:1px solid #22243a; font-size:11px;';
  const cat = document.createElement('span');
  cat.className = 'pill';
  cat.style.fontSize = '9px';
  cat.textContent = rfx.category;
  row.appendChild(cat);
  const id = document.createElement('code');
  id.style.cssText = 'min-width:140px; color:#cbd0dd;';
  id.textContent = rfx.id;
  row.appendChild(id);
  const txt = document.createElement('span');
  txt.style.cssText = 'flex:1; color:#c0c4d0;';
  txt.textContent = rfx.text;
  row.appendChild(txt);
  // QA verdict from the round-trip validator: pass / fail / unchecked.
  const qa = document.createElement('span');
  qa.className = 'pill';
  qa.style.fontSize = '9px';
  if (rfx.validated === true) { qa.textContent = 'QA ✓'; qa.style.color = '#22c55e'; qa.style.borderColor = '#22c55e'; }
  else if (rfx.validated === false) { qa.textContent = 'QA ✗'; qa.style.color = '#ef4444'; qa.style.borderColor = '#ef4444'; }
  else { qa.textContent = 'QA ·'; qa.style.color = '#9999b4'; }
  const heardBits = [];
  if (rfx.heard) heardBits.push('heard: ' + rfx.heard);
  if (rfx.effective_text && rfx.effective_text !== rfx.text) heardBits.push('says: ' + rfx.effective_text);
  if (heardBits.length) qa.title = heardBits.join('\n');
  row.appendChild(qa);
  if (rfx.effective_text && rfx.effective_text !== rfx.text) {
    const eff = document.createElement('span');
    eff.style.cssText = 'color:#7c83a0; font-style:italic; font-size:10px;';
    eff.textContent = '→ ' + rfx.effective_text;
    row.appendChild(eff);
  }
  if (rfx.available) {
    const ok = document.createElement('span');
    ok.className = 'pill';
    ok.style.color = '#22c55e';
    ok.style.borderColor = '#22c55e';
    ok.textContent = `✓ ${rfx.size_bytes}B`;
    row.appendChild(ok);
    const btn = document.createElement('button');
    btn.type = 'button';
    btn.className = 'secondary';
    btn.style.fontSize = '11px';
    btn.textContent = '▶ Play';
    btn.addEventListener('click', () => playReflex(rfx.id));
    row.appendChild(btn);
  } else {
    const missing = document.createElement('span');
    missing.className = 'pill';
    missing.style.color = '#fbbf24';
    missing.style.borderColor = '#fbbf24';
    missing.textContent = '⚠ missing';
    row.appendChild(missing);
  }
  return row;
}

function playReflex(id) {
  const buf = reflexBuffers.get(id);
  if (!buf) {
    // Reflex isn't preloaded — typically because HiveMind TTS was cold
    // at boot and the prewarm thread couldn't reach it. Silently skip;
    // the caller's fallback path (real TTS turn / red error) still runs.
    return false;
  }
  try {
    const ctx = getPlaybackCtx();
    const source = ctx.createBufferSource();
    source.buffer = buf;
    source.connect(oraclePlaybackNodeForSource(ctx));
    const startAt = Math.max(nextChunkStartTime, ctx.currentTime);
    source.start(startAt);
    nextChunkStartTime = startAt + buf.duration;
    const entry = {source, startAt, endAt: startAt + buf.duration};
    activeAudioSources.push(entry);
    markOraclePlaybackActive();
    source.onended = () => {
      activeAudioSources = activeAudioSources.filter(e => (e.source || e) !== source);
    };
    return true;
  } catch (exc) {
    console.warn('playReflex failed:', id, exc);
    return false;
  }
}

function playRandomReflex(category) {
  const candidates = [];
  for (const [id, meta] of reflexMetaById) {
    if (meta.category === category && reflexBuffers.has(id)) candidates.push(id);
  }
  if (!candidates.length) return false;
  const pick = candidates[Math.floor(Math.random() * candidates.length)];
  return playReflex(pick);
}

// Wire the barge-in ack toggle. When on, every bargeIn(reason) call
// plays a random "ack" reflex AFTER the in-flight audio is stopped so
// the user hears "Mhm?" or "Yes?" the instant they press the mic.
function isReflexBargeAckEnabled() {
  return localStorage.getItem(REFLEX_BARGE_ACK_KEY) === 'true';
}

// Patch bargeIn so it optionally plays an ack reflex. We wrap the
// existing bargeIn instead of editing it inline so the barge-in
// machinery itself stays focused on the cancellation contract.
const _coreBargeIn = bargeIn;
bargeIn = function patchedBargeIn(reason) {
  _coreBargeIn(reason);
  if (isReflexBargeAckEnabled()) {
    // Tiny delay so the previous source's stop() flushes before the
    // ack starts — otherwise the audio context schedules them back-
    // to-back and the ack can be clipped on some browsers.
    setTimeout(() => playRandomReflex('ack'), 20);
  }
};

