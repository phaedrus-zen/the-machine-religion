// ----- HiveMind cluster state -----------------------------------------
// Surfaces `hivemind.jobs.active@v1` + `hivemind.cluster.load@v1` so the
// operator can see at a glance whether the cluster is busy and the
// Face Lobe's "what's running?" answers are grounded in the same data.
const settingsHivemindState = document.getElementById('settingsHivemindState');
const settingsHivemindStatus = document.getElementById('settingsHivemindStatus');
const settingsHivemindRefresh = document.getElementById('settingsHivemindRefresh');

function renderHivemindStateBlock(snapshot) {
  if (!settingsHivemindState) return;
  if (!snapshot) {
    settingsHivemindState.textContent = '(no data)';
    return;
  }
  const lines = [];
  lines.push(`hivemind_url       = ${snapshot.hivemind_url || '?'}`);
  lines.push(`mcp_base_url       = ${snapshot.mcp_base_url || '?'}`);
  lines.push(`auth_configured    = ${snapshot.auth_configured ? 'yes (MS4_HIVEMIND_API_KEY set)' : 'no'}`);
  const active = snapshot.active_jobs || {};
  lines.push('');
  lines.push('-- hivemind.jobs.active@v1 --');
  lines.push(`total_active       = ${active.total_active ?? '?'}`);
  lines.push(`summary            = ${active.summary || '(empty)'}`);
  for (const key of ['inference', 'pulls', 'scatter', 'training']) {
    const arr = active[key];
    if (Array.isArray(arr) && arr.length) {
      lines.push(`${key.padEnd(19)}= ${arr.length} entry(ies)`);
    }
  }
  const load = snapshot.cluster_load || {};
  if (load && Object.keys(load).length) {
    const trackers = load.trackers || {};
    const retries = load.retries || {};
    const peers = load.peers || {};
    const shed = load.shed_total || {};
    lines.push('');
    lines.push('-- hivemind.cluster.load@v1 --');
    lines.push(`amplification      = ${trackers.amplification_ratio ?? '?'}`);
    lines.push(`unique_traces      = ${trackers.unique_traces ?? '?'}`);
    lines.push(`retries.budget_rej = ${retries.rejected_for_budget_total ?? 0}`);
    lines.push(`peers.overload     = ${peers.overload_signals_total ?? 0}`);
    lines.push(`shed (deadline)    = ${shed.deadline ?? 0}`);
    lines.push(`shed (budget)      = ${shed.budget ?? 0}`);
    lines.push(`shed (peer_over)   = ${shed.peer_overload ?? 0}`);
  }
  const health = snapshot.service_health || {};
  // hivemind.service_health@v1 returns a flat object with a mix of
  // service entries (objects with .healthy) AND metadata fields like
  // "fresh", "ollama_facade", "polling_model", "validation". Filter
  // to only entries that look like real service records — an object
  // with an explicit `healthy` boolean.
  const serviceEntries = Object.entries(health).filter(
    ([_name, entry]) => entry && typeof entry === 'object' && typeof entry.healthy === 'boolean',
  );
  if (serviceEntries.length) {
    lines.push('');
    lines.push('-- hivemind.service_health@v1 --');
    const unhealthy = serviceEntries.filter(([_name, entry]) => entry.healthy === false);
    lines.push(`services           = ${serviceEntries.length} total, ${unhealthy.length} unhealthy`);
    for (const [name, entry] of unhealthy.slice(0, 6)) {
      lines.push(`  X ${name}: ${entry.error || entry.detail || entry.last_error || '(no error msg)'}`);
    }
  }
  if (snapshot.errors && snapshot.errors.length) {
    lines.push('');
    lines.push(`errors             = ${snapshot.errors.join('; ')}`);
  }
  settingsHivemindState.innerHTML = '';
  const pre = document.createElement('pre');
  pre.style.cssText = 'margin:0; white-space:pre-wrap; background:#0e0f17; padding:6px; border-radius:6px; border:1px solid #2d2d44; font-size:11px;';
  pre.textContent = lines.join('\n');
  settingsHivemindState.appendChild(pre);
}

async function refreshHivemindState() {
  if (!settingsHivemindState) return;
  settingsHivemindState.textContent = 'Loading…';
  if (settingsHivemindStatus) settingsHivemindStatus.textContent = '';
  try {
    const r = await fetch('/hivemind/state', {cache: 'no-store'});
    if (!r.ok) throw new Error(`HTTP ${r.status}`);
    const data = await r.json();
    renderHivemindStateBlock(data);
    if (settingsHivemindStatus) {
      settingsHivemindStatus.textContent = data.errors && data.errors.length
        ? `${data.errors.length} partial failure(s)`
        : 'OK';
