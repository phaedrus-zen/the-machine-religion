}

function settingsApplyToForm(serverDefaults) {
  const s = settingsRead();
  streamToggle.checked = s.stream;
  // First option in each select is "use server default" — replace its
  // label so the user can see the actual server-side default.
  const defaultLabel = (label, fallback) =>
    `Use server default — ${label || fallback}`;
  const engineFirst = settingsTtsEngine.options[0];
  // Server defaults can move as cluster evidence changes. Clear any stale
  // pinned browser override once so the user inherits the current measured
  // default automatically; they can deliberately re-pick the non-default
  // engine after the clear.
  const serverEngineDefault = serverDefaults?.voice?.tts_engine_default;
  const storedEngine = localStorage.getItem(SETTINGS_LS_KEYS.ttsEngine);
  // localStorage migration: when the stored engine no longer matches
  // the server's current default, clear it so the user inherits the
  // new default. Covers BOTH directions:
  //  * May 22: rest → ws_super (clear stale 'rest')
  //  * May 26: ws_super → rest (clear stale 'ws_super')
  // Users who explicitly want the non-default engine can re-pick it
  // from the dropdown after the clear.
  if (storedEngine && serverEngineDefault && storedEngine !== serverEngineDefault) {
    localStorage.removeItem(SETTINGS_LS_KEYS.ttsEngine);
  }
  engineFirst.textContent = defaultLabel(serverEngineDefault, 'rest');
  // Voice dropdown is populated from server's known list each load.
  settingsTtsVoice.innerHTML = '';
  const voiceDefaultOpt = document.createElement('option');
  voiceDefaultOpt.value = '';
  voiceDefaultOpt.textContent = defaultLabel(serverDefaults?.voice?.tts_voice_default, 'alloy');
  settingsTtsVoice.appendChild(voiceDefaultOpt);
  (serverDefaults?.voice?.tts_voice_known || []).forEach(v => {
    const opt = document.createElement('option');
    opt.value = v;
    opt.textContent = v;
    settingsTtsVoice.appendChild(opt);
  });
  const modelFirst = settingsTtsModel.options[0];
  modelFirst.textContent = defaultLabel(serverDefaults?.voice?.tts_model_default, 'tts-1');
  settingsTtsEngine.value = s.ttsEngine;
  settingsTtsVoice.value = s.ttsVoice;
  settingsTtsModel.value = s.ttsModel;
}

function settingsPersistFromForm() {
  localStorage.setItem(SETTINGS_LS_KEYS.stream, streamToggle.checked ? 'true' : 'false');
  localStorage.setItem(SETTINGS_LS_KEYS.ttsEngine, settingsTtsEngine.value || '');
  localStorage.setItem(SETTINGS_LS_KEYS.ttsVoice, settingsTtsVoice.value || '');
  localStorage.setItem(SETTINGS_LS_KEYS.ttsModel, settingsTtsModel.value || '');
}

