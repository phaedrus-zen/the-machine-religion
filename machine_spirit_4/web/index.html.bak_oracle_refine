function voiceQueryParams() {
  const s = settingsRead();
  const params = new URLSearchParams();
  if (sessionId) params.set('session_id', sessionId);
  if (s.ttsEngine) params.set('engine', s.ttsEngine);
  if (s.ttsVoice) params.set('voice', s.ttsVoice);
  // The TTS model (tts-1 / tts-1-hd) MUST go to ?tts_model=, not ?model=,
  // because the gateway treats ?model= as the FACE LOBE chat model. The
  // earlier bug shipped 'tts-1' as the chat model, causing every voice
  // turn to fall back to the canned-failure reply.
  if (s.ttsModel) params.set('tts_model', s.ttsModel);
  // Top-level chat model dropdown (modelSelect) — if the operator
  // explicitly picked a chat model, honor it for the voice turn too.
  if (modelSelect && modelSelect.value) params.set('model', modelSelect.value);
  // Depth Lobe model for any deep job this voice turn dispatches.
  if (depthModelSelect && depthModelSelect.value) params.set('depth_model_id', depthModelSelect.value);
  return params;
}

