function _fmtTime(iso) {
  if (!iso) return '';
  try {
    const d = new Date(iso);
    if (Number.isNaN(d.getTime())) return iso;
    const hh = String(d.getHours()).padStart(2, '0');
    const mm = String(d.getMinutes()).padStart(2, '0');
    const ss = String(d.getSeconds()).padStart(2, '0');
    return `${hh}:${mm}:${ss}`;
  } catch (e) {
    return iso;
  }
}

function _fmtMs(ms) {
  if (ms == null) return '';
  if (ms < 1000) return `${Math.round(ms)}ms`;
  return `${(ms / 1000).toFixed(2)}s`;
}

function renderAssistantMeta(el, meta = {}) {
  // ---- model / runtime / grounding / session row
  const m = document.createElement('div');
  m.className = 'meta';
  const parts = [];
  if (meta.runtime) parts.push(meta.runtime);
  if (meta.face_lobe_model?.model_id) {
    parts.push(`face=${meta.face_lobe_model.model_id} (${meta.face_lobe_model.source || ''})`);
  } else if (meta.model) {
    parts.push(`model=${meta.model}`);
  }
  if (meta.fallback_used && meta.requested_model && meta.requested_model !== meta.model) {
    parts.push(`fallback from ${meta.requested_model}`);
  }
  if (meta.grounding_source) parts.push(`grounding=${meta.grounding_source}`);
  if (meta.hermes_session_id) parts.push(meta.hermes_session_id);
  m.textContent = parts.join(' · ');
  el.appendChild(m);

  // ---- metrics row: timestamp · duration · TTFB · tokens · tok/s
  if (meta.metrics) {
    const mx = meta.metrics;
    const metricsPill = document.createElement('div');
    metricsPill.className = 'meta';
    metricsPill.style.color = '#94a3b8';
    const mparts = [];
    if (mx.started_at || mx.completed_at) mparts.push(`@${_fmtTime(mx.completed_at || mx.started_at)}`);
    if (mx.duration_ms != null) mparts.push(`${_fmtMs(mx.duration_ms)} wall`);
    if (mx.stream_first_token_ms != null) mparts.push(`TTFB ${_fmtMs(mx.stream_first_token_ms)}`);
    const tokensIn = mx.prompt_tokens;
    const tokensOut = mx.completion_tokens;
    if (tokensIn != null || tokensOut != null) {
      mparts.push(`tokens ${tokensIn ?? '?'}→${tokensOut ?? '?'}`);
    }
    if (mx.tokens_per_second != null) mparts.push(`${mx.tokens_per_second} tok/s`);
    if (mx.api_calls && mx.api_calls > 1) mparts.push(`api_calls=${mx.api_calls}`);
    if (mx.stream_chunks) mparts.push(`${mx.stream_chunks} chunks`);
    metricsPill.textContent = mparts.length ? `📊 ${mparts.join(' · ')}` : '';
    metricsPill.title = JSON.stringify(mx, null, 2);
    if (metricsPill.textContent) el.appendChild(metricsPill);
  }

  // ---- router / dispatched job row
  if (meta.dispatched_job && meta.dispatched_job.job_id) {
    const pill = document.createElement('div');
    pill.className = 'meta';
    pill.style.color = '#a855f7';
    const depth = meta.depth_lobe_model?.model_id || 'depth lobe';
    pill.textContent = `🧠 Depth Lobe dispatched (${depth}) — job ${meta.dispatched_job.job_id} · router: ${meta.router?.source || ''}/${meta.router?.reason || ''}`;
    el.appendChild(pill);
    refreshDoubleAgent();
  } else if (meta.router && meta.router.kind === 'direct' && meta.router.source !== 'slash') {
    const pill = document.createElement('div');
    pill.className = 'meta';
    pill.style.color = '#6b7280';
    pill.textContent = `router: direct (${meta.router.reason})`;
    el.appendChild(pill);
  }

  // ---- tool trace (Hermes path only)
  if (Array.isArray(meta.tool_trace) && meta.tool_trace.length) {
    const trace = document.createElement('details');
    const summary = document.createElement('summary');
    summary.textContent = `Hermes tool trace (${meta.tool_trace.length})`;
    trace.appendChild(summary);
    const pre = document.createElement('pre');
    pre.textContent = JSON.stringify(meta.tool_trace, null, 2);
    trace.appendChild(pre);
    el.appendChild(trace);
  }
}

function addMessage(role, text, meta = {}) {
  const el = document.createElement('div');
  el.className = `msg ${role}`;
  el.textContent = text;
  if (role === 'assistant') {
    renderAssistantMeta(el, meta);
  }
  messages.appendChild(el);
  messages.scrollTop = messages.scrollHeight;
  return el;
}

function createStreamingAssistantMessage() {
  const el = document.createElement('div');
  el.className = 'msg assistant';
  const textNode = document.createTextNode('');
  el.appendChild(textNode);
  messages.appendChild(el);
  messages.scrollTop = messages.scrollHeight;
  return {el, textNode};
}

function finishAssistantMessage(el, meta = {}) {
  renderAssistantMeta(el, meta);
  messages.scrollTop = messages.scrollHeight;
}

