// Curated small/fast chat models for sub-second first-token on voice.
// Ordered best-first; only those present in the live catalog are shown.
// A 3-4B-class model gives ChatGPT-phone-like responsiveness AND
// contends far less for GPU memory than an 8B+ model sharing the card
// with the 27B Depth Lobe.
const FAST_FACE_MODELS = [
  'phi4-mini:latest',
  'ministral-3:latest',
  'Llama-3.2-3B-Instruct-uncensored',
  'llama3.2',
  'gemma3',
  'qwen3:0.6b',
  'phi3.5:latest',
  'qwen2.5:0.5b',
];

function _modelOption(model) {
  const option = document.createElement('option');
  option.value = model.id;
  option.textContent = `${model.loaded ? '●' : model.available ? '◐' : '○'} ${model.id}`;
  return option;
}

const NON_CHAT_MODEL_ID_RES = [
  /(^|[-_:])asr($|[-_:])/,
  /(^|[-_:])diar/,
  /(^|[-_:])embed/,
  /(^|[-_:])flux($|[-_:])/,
  /(^|[-_:])image($|[-_:])/,
  /(^|[-_:])moderation($|[-_:])/,
  /(^|[-_:])ocr($|[-_:])/,
  /(^|[-_:])parler($|[-_:])/,
  /(^|[-_:])piper($|[-_:])/,
  /(^|[-_:])rerank($|[-_:])/,
  /(^|[-_:])sd($|[-_:])/,
  /(^|[-_:])speech($|[-_:])/,
  /(^|[-_:])stt($|[-_:])/,
  /(^|[-_:])tts($|[-_:])/,
  /(^|[-_:])vad($|[-_:])/,
  /(^|[-_:])vision($|[-_:])/,
  /(^|[-_:])vl($|[-_:])/,
  /(^|[-_:])vlm($|[-_:])/,
  /(^|[-_:])whisper($|[-_:])/,
  /bge[-_:]/,
  /nomic[-_:]embed/,
  /stable[-_:]?diffusion/,
  /xtts/,
];

function isChatCapableModel(model) {
  const id = String(model?.id || model?.model || model?.name || '').toLowerCase();
  return id && !NON_CHAT_MODEL_ID_RES.some(re => re.test(id));
}

function _fillModelDropdown(sel, autoLabel, models, savedValue, recommendFast) {
  sel.innerHTML = '';
  const auto = document.createElement('option');
  auto.value = '';
  auto.textContent = autoLabel;
  sel.appendChild(auto);
  const list = models || [];
  if (recommendFast) {
    // Surface curated fast models in a group at the top so the operator
    // can pick a snappy voice model without scrolling the full catalog.
    const byId = new Map(list.map(m => [m.id, m]));
    const fast = FAST_FACE_MODELS.map(id => byId.get(id)).filter(Boolean);
    if (fast.length) {
      const grp = document.createElement('optgroup');
      grp.label = '\u26a1 Fast \u2014 best for voice latency';
      fast.forEach(m => grp.appendChild(_modelOption(m)));
      sel.appendChild(grp);
      const grpAll = document.createElement('optgroup');
      grpAll.label = 'All models';
      list.forEach(m => grpAll.appendChild(_modelOption(m)));
      sel.appendChild(grpAll);
      if (savedValue && [...sel.querySelectorAll('option')].some(o => o.value === savedValue)) sel.value = savedValue;
      return;
    }
  }
  list.forEach(model => sel.appendChild(_modelOption(model)));
  if (savedValue && [...sel.options].some(o => o.value === savedValue)) sel.value = savedValue;
}

async function loadModels() {
  const faceSel = localStorage.getItem('ms4_model_id') || '';
  const depthSel = localStorage.getItem('ms4_depth_model_id') || '';
  const controller = new AbortController();
  const timeout = setTimeout(() => controller.abort(), 8000);
  try {
    const r = await fetch('/models', {signal: controller.signal});
    const data = await r.json();
    if (!r.ok) throw new Error(data.error || r.statusText);
    const models = (data.models || []).filter(isChatCapableModel);
    if (faceSel && !models.some(m => m.id === faceSel)) localStorage.removeItem('ms4_model_id');
    if (depthSel && !models.some(m => m.id === depthSel)) localStorage.removeItem('ms4_depth_model_id');
    _fillModelDropdown(modelSelect, 'Auto-pick Face Lobe model (small/fast)', models, faceSel, true);
    _fillModelDropdown(depthModelSelect, 'Auto (recommended depth model)', models, depthSel, false);
  } catch (error) {
    modelSelect.innerHTML = '<option value="">Auto-pick Face Lobe model (small/fast)</option>';
    depthModelSelect.innerHTML = '<option value="">Auto (recommended depth model)</option>';
    console.warn('Failed to load MS4 model catalog:', error);
  } finally {
    clearTimeout(timeout);
  }
}

