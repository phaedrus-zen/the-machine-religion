<script>
const messages = document.getElementById('messages');
const appRoot = document.getElementById('appRoot');
const statusEl = document.getElementById('status');
const sessionEl = document.getElementById('sessionId');
const voiceEl = document.getElementById('voiceStatus');
const modelSelect = document.getElementById('modelSelect');
const depthModelSelect = document.getElementById('depthModelSelect');
// The Stream toggle lives in the Settings dialog now. Keep a stable
// reference so the rest of the existing chat flow doesn't need to
// change; settings logic below keeps localStorage in sync.
const streamToggle = document.getElementById('settingsStreamToggle');
let sessionId = localStorage.getItem('ms4_session_id') || '';

const oracleStage = document.getElementById('oracleStage');
const oracleMirror = document.getElementById('oracleMirror');
const oracleSubtitle = document.getElementById('oracleSubtitle');
const oracleTranscriptLine = document.getElementById('oracleTranscriptLine');
const oraclePresenceChip = document.getElementById('oraclePresenceChip');
const oracleTimingLine = document.getElementById('oracleTimingLine');
const oracleLobeLine = document.getElementById('oracleLobeLine');
const oracleLobesLine = document.getElementById('oracleLobesLine');
const oracleHandsfreePrompt = document.getElementById('oracleHandsfreePrompt');
const oracleStartHandsfree = document.getElementById('oracleStartHandsfree');
const oracleKeepPushToTalk = document.getElementById('oracleKeepPushToTalk');
const oracleVoiceReadiness = document.getElementById('oracleVoiceReadiness');
const oracleVoiceReadinessText = document.getElementById('oracleVoiceReadinessText');
const oracleProvisionVoiceBtn = document.getElementById('oracleProvisionVoiceBtn');
let oracleRenderedPresence = '';
let oraclePresenceAnimationFrame = 0;
let oraclePresenceStartedAt = performance.now();
let oracleMicLevel = 0;
let oracleIdleAfterPlaybackTimer = null;
let oraclePlaybackAnalyser = null;
let oraclePlaybackAnalyserData = null;
let oraclePlaybackTimeData = null;
let oraclePlaybackNode = null;
let oraclePlaybackSignal = {level: 0, voice: 0, air: 0, active: false};

const ORACLE_PRESENCE_LABELS = {
  idle: 'Ready',
  listening: 'Listening',
  thinking: 'Thinking',
  speaking: 'Speaking',
  blocked: 'Blocked',
  error: 'Needs attention',
};

function oraclePreview(text, maxLen = 180) {
  const value = String(text || '').replace(/\s+/g, ' ').trim();
  if (!value) return '';
  return value.length > maxLen ? `${value.slice(0, maxLen - 1)}...` : value;
}

function oracleClamp01(value) {
  return Math.max(0, Math.min(1, Number(value) || 0));
}

function clearOracleIdleTimer() {
  if (!oracleIdleAfterPlaybackTimer) return;
  clearTimeout(oracleIdleAfterPlaybackTimer);
  oracleIdleAfterPlaybackTimer = null;
}

function setOracleStageState(presence, subtitle, detail) {
  if (!oracleStage) return;
  const safePresence = ORACLE_PRESENCE_LABELS[presence] ? presence : 'idle';
  const changed = oracleStage.dataset.presence !== safePresence;
  if (safePresence !== 'idle') clearOracleIdleTimer();
  oracleStage.dataset.presence = safePresence;
  oracleStage.dataset.turnPhase = safePresence;
  oracleStage.dataset.audioReactive = safePresence === 'idle' ? 'false' : 'true';
  if (oracleMirror) {
    oracleMirror.dataset.presence = safePresence;
    oracleMirror.dataset.audioReactive = oracleStage.dataset.audioReactive;
  }
  if (oraclePresenceChip) {
    oraclePresenceChip.textContent = '';
    const strong = document.createElement('strong');
    strong.textContent = ORACLE_PRESENCE_LABELS[safePresence];
    oraclePresenceChip.appendChild(strong);
  }
  if (oracleSubtitle && subtitle !== undefined) {
    oracleSubtitle.textContent = oraclePreview(subtitle, 220) || 'Ready.';
  }
  if (oracleTimingLine && detail !== undefined) {
    oracleTimingLine.textContent = oraclePreview(detail, 220);
  }
  if (changed) renderOracleMirror();
  startOraclePresenceAnimation();
}

function setOracleStageTranscript(text, speakerName) {
  if (!oracleTranscriptLine) return;
  const preview = oraclePreview(text, 190);
  if (!preview) {
    oracleTranscriptLine.textContent = '';
    return;
  }
  oracleTranscriptLine.textContent = `${speakerName || 'You'}: ${preview}`;
}

function setOracleTiming(text) {
  if (oracleTimingLine) oracleTimingLine.textContent = oraclePreview(text, 220);
}

function setOracleLobeState(jobs) {
  if (!oracleLobeLine || !oracleLobesLine) return;
  const activeJobs = (jobs || []).filter(job => job && (job.state === 'queued' || job.state === 'running'));
  if (!activeJobs.length) {
    oracleLobeLine.textContent = 'Face Lobe';
    oracleLobesLine.textContent = '';
    return;
  }
  const kinds = Array.from(new Set(activeJobs.map(job => job.background_lobe_type || 'background').slice(0, 4)));
  oracleLobeLine.textContent = `Backend lobes active: ${kinds.join(', ')}`;
  oracleLobesLine.textContent = activeJobs
    .slice(0, 3)
    .map(job => `${job.background_lobe_type || 'lobe'} ${job.state}: ${oraclePreview(job.user_visible_goal || job.job_id, 60)}`)
    .join(' | ');
}

function setOracleInputLevel(rms) {
  const threshold = typeof vadSpeechThreshold === 'function' ? vadSpeechThreshold() : 0.025;
  const normalized = oracleClamp01((Number(rms) || 0) / Math.max(0.012, threshold * 2.6));
  oracleMicLevel = Math.max(oracleMicLevel * 0.68, normalized);
}

function oraclePresenceProfile(presence) {
  switch (presence) {
    case 'listening':
      return {level: 0.34, voice: 0.12, air: 0.46, cell: 0.34, link: 0.28, tempo: 1.45};
    case 'thinking':
      return {level: 0.28, voice: 0.10, air: 0.30, cell: 0.38, link: 0.38, tempo: 0.82};
    case 'speaking':
      return {level: 0.64, voice: 0.58, air: 0.42, cell: 0.58, link: 0.42, tempo: 2.8};
    case 'blocked':
    case 'error':
      return {level: 0.42, voice: 0.12, air: 0.18, cell: 0.46, link: 0.26, tempo: 1.1};
    default:
      return {level: 0.10, voice: 0.05, air: 0.10, cell: 0.16, link: 0.12, tempo: 0.48};
  }
}

function resetOraclePlaybackSignal() {
  oraclePlaybackSignal = {level: 0, voice: 0, air: 0, active: false};
}

function ensureOraclePlaybackAnalyser(ctx) {
  if (!ctx || typeof ctx.createAnalyser !== 'function') return null;
  if (oraclePlaybackAnalyser && oraclePlaybackAnalyser.context === ctx && oraclePlaybackNode) {
    return oraclePlaybackNode;
  }
  const analyser = ctx.createAnalyser();
  analyser.fftSize = 512;
  analyser.smoothingTimeConstant = 0.68;
  const output = ctx.createGain();
  output.gain.value = 1;
  analyser.connect(output);
  output.connect(ctx.destination);
  oraclePlaybackAnalyser = analyser;
  oraclePlaybackAnalyserData = new Uint8Array(analyser.frequencyBinCount);
  oraclePlaybackTimeData = new Uint8Array(analyser.fftSize);
  oraclePlaybackNode = analyser;
  return oraclePlaybackNode;
}

function oraclePlaybackNodeForSource(ctx) {
  return ensureOraclePlaybackAnalyser(ctx) || (ctx && ctx.destination);
}

function readOraclePlaybackSignal() {
  if (!oraclePlaybackAnalyser || !oraclePlaybackAnalyserData || !oraclePlaybackTimeData) {
    oraclePlaybackSignal = {
      level: oraclePlaybackSignal.level * 0.78,
      voice: oraclePlaybackSignal.voice * 0.76,
      air: oraclePlaybackSignal.air * 0.76,
      active: false,
    };
    return oraclePlaybackSignal;
  }
  try {
    oraclePlaybackAnalyser.getByteFrequencyData(oraclePlaybackAnalyserData);
    oraclePlaybackAnalyser.getByteTimeDomainData(oraclePlaybackTimeData);
  } catch (e) {
    oraclePlaybackSignal = {
      level: oraclePlaybackSignal.level * 0.78,
      voice: oraclePlaybackSignal.voice * 0.76,
      air: oraclePlaybackSignal.air * 0.76,
      active: false,
    };
    return oraclePlaybackSignal;
  }

  let rmsSum = 0;
  for (let i = 0; i < oraclePlaybackTimeData.length; i += 1) {
    const centered = (oraclePlaybackTimeData[i] - 128) / 128;
    rmsSum += centered * centered;
  }
  const rms = Math.sqrt(rmsSum / Math.max(1, oraclePlaybackTimeData.length));

  let avg = 0;
  let voice = 0;
  let voiceBins = 0;
  let air = 0;
  let airBins = 0;
  const sampleRate = oraclePlaybackAnalyser.context?.sampleRate || 48000;
  const binHz = sampleRate / oraclePlaybackAnalyser.fftSize;
  for (let i = 0; i < oraclePlaybackAnalyserData.length; i += 1) {
    const magnitude = oraclePlaybackAnalyserData[i] / 255;
    const hz = i * binHz;
    avg += magnitude;
    if (hz >= 140 && hz <= 3600) {
      voice += magnitude;
      voiceBins += 1;
    } else if (hz > 3600 && hz <= 8200) {
      air += magnitude;
      airBins += 1;
    }
  }
  avg /= Math.max(1, oraclePlaybackAnalyserData.length);
  voice = voiceBins ? voice / voiceBins : avg;
  air = airBins ? air / airBins : avg * 0.5;

  const rawLevel = oracleClamp01(Math.max(rms * 2.4, avg * 1.8));
  const rawVoice = oracleClamp01(voice * 2.1 + rms * 0.28);
  const rawAir = oracleClamp01(air * 1.8);
  oraclePlaybackSignal = {
    level: Math.max(oraclePlaybackSignal.level * 0.58, rawLevel),
    voice: Math.max(oraclePlaybackSignal.voice * 0.55, rawVoice),
    air: Math.max(oraclePlaybackSignal.air * 0.62, rawAir),
    active: rawLevel > 0.018 || rawVoice > 0.022,
  };
  return oraclePlaybackSignal;
}

function startOraclePresenceAnimation() {
  if (!oracleStage || !oracleMirror || oraclePresenceAnimationFrame) return;
  oraclePresenceStartedAt = performance.now();
  const tick = () => {
    syncOraclePresenceAnimation(performance.now());
    oraclePresenceAnimationFrame = requestAnimationFrame(tick);
  };
  tick();
}

function syncOraclePresenceAnimation(now) {
  if (!oracleStage || !oracleMirror) return;
  const presence = oracleStage.dataset.presence || 'idle';
  const profile = oraclePresenceProfile(presence);
  const t = (now - oraclePresenceStartedAt) / 1000;
  const slow = 0.5 + 0.5 * Math.sin(t * Math.PI * profile.tempo);
  const fast = 0.5 + 0.5 * Math.sin(t * Math.PI * (profile.tempo * 2.9) + 0.8);
  const playback = presence === 'speaking' ? readOraclePlaybackSignal() : {
    level: oraclePlaybackSignal.level * 0.82,
    voice: oraclePlaybackSignal.voice * 0.78,
    air: oraclePlaybackSignal.air * 0.78,
    active: false,
  };
  if (presence !== 'speaking') oraclePlaybackSignal = playback;
  const speechBeat = presence === 'speaking'
    ? playback.active
      ? oracleClamp01(0.12 + playback.level * 0.72 + playback.voice * 0.34 + fast * 0.08)
      : oracleClamp01(0.34 + slow * 0.32 + fast * 0.34)
    : 0;
  const listenLift = presence === 'listening' ? oracleMicLevel : 0;
  const thoughtLift = presence === 'thinking' ? 0.12 + slow * 0.18 : 0;
  const level = oracleClamp01(profile.level + listenLift * 0.42 + thoughtLift + speechBeat * 0.22 + playback.level * 0.42);
  const voice = oracleClamp01(profile.voice + listenLift * 0.14 + speechBeat * 0.24 + playback.voice * 0.62);
  const air = oracleClamp01(profile.air + listenLift * 0.34 + playback.air * 0.36 + fast * (presence === 'listening' ? 0.16 : 0.06));
  const cell = oracleClamp01(profile.cell + listenLift * 0.28 + speechBeat * 0.26 + playback.level * 0.30 + slow * 0.10);
  const link = oracleClamp01(profile.link + listenLift * 0.20 + speechBeat * 0.14 + playback.air * 0.20 + fast * 0.06);

  [oracleStage, oracleMirror].forEach((el) => {
    el.style.setProperty('--audio-level', level.toFixed(3));
    el.style.setProperty('--audio-voice', voice.toFixed(3));
    el.style.setProperty('--audio-air', air.toFixed(3));
    el.style.setProperty('--cell-audio', cell.toFixed(3));
    el.style.setProperty('--link-audio', link.toFixed(3));
  });
  oracleMirror.dataset.presence = presence;
  oracleMirror.dataset.audioReactive = presence === 'idle' ? 'false' : 'true';

  const bars = oracleMirror.querySelectorAll('.mirror-speaking-bar');
  const center = (bars.length - 1) / 2;
  bars.forEach((bar, index) => {
    const distance = Math.abs(index - center) / Math.max(1, center);
    const syllable = Math.abs(Math.sin(t * Math.PI * (3.3 + (index % 5) * 0.42) + index * 0.74));
    const centered = 1 - distance * 0.46;
    const barLevel = presence === 'speaking'
      ? oracleClamp01((voice * 0.62 + syllable * 0.44 + speechBeat * 0.34) * centered)
      : 0;
    bar.style.setProperty('--audio-scale', (presence === 'speaking' ? 0.08 + barLevel * 1.28 : 0).toFixed(3));
    bar.style.setProperty('--audio-opacity', (presence === 'speaking' ? 0.08 + barLevel * 0.90 : 0.02).toFixed(3));
  });

  const cells = oracleMirror.querySelectorAll('.mirror-cell.is-active');
  cells.forEach((cellEl, index) => {
    const wave = 0.5 + 0.5 * Math.sin(t * Math.PI * profile.tempo + index * 0.62);
    const shape = cellEl.dataset.cellShape || '';
    const shapeLift = shape === 'voice' && presence === 'speaking'
      ? voice * 0.74
      : shape === 'eye'
        ? air * 0.42
        : shape === 'edge' || shape === 'jaw'
          ? level * 0.34
          : level * 0.24;
    cellEl.style.setProperty('--cell-audio', oracleClamp01(0.06 + profile.cell * 0.30 + shapeLift + wave * 0.14).toFixed(3));
  });

  oracleMirror.querySelectorAll('.mirror-cell-link').forEach((linkEl, index) => {
    const wave = 0.5 + 0.5 * Math.sin(t * Math.PI * (profile.tempo * 1.4) + index * 0.22);
    linkEl.style.setProperty('--link-audio', oracleClamp01(0.04 + link * 0.56 + wave * 0.08).toFixed(3));
  });

  oracleMicLevel *= presence === 'listening' ? 0.92 : 0.84;
}

function setOracleStageFromVoiceStatus(text, kind) {
  const value = String(text || '');
  if (!value) return;
  if (kind === 'error') {
    setOracleStageState('error', value, 'Voice or cluster path needs attention.');
    return;
  }
  if (kind === 'ok') {
    if (/First audio/i.test(value)) {
      setOracleStageState('speaking', 'Oracle is speaking.', value);
    } else if (/complete/i.test(value)) {
      scheduleOracleIdleAfterPlayback((oracleSubtitle && oracleSubtitle.textContent) || 'Ready.', value);
    }
  }
}

function oracleHexPoints(cx, cy, r) {
  return Array.from({ length: 6 }, (_, index) => {
    const angle = (Math.PI / 3) * index - Math.PI / 6;
    return `${(cx + Math.cos(angle) * r).toFixed(1)},${(cy + Math.sin(angle) * r).toFixed(1)}`;
  }).join(' ');
}

function oracleMirrorCellSpecs() {
  const specs = [];
  const center = 180;
  const radius = 9.0;
  const xStep = Math.sqrt(3) * radius;
  const yStep = 1.5 * radius;
  let rowIndex = 0;
  for (let cy = 28; cy <= 300; cy += yStep, rowIndex += 1) {
    const half = rowIndex % 2 ? 0.5 : 0;
    const row = rowIndex - 10;
    for (let col = -12; col <= 12; col += 1) {
      const cx = center + (col + half) * xStep;
      if (cx < 18 || cx > 342) continue;
      if (Math.pow((cx - center) / 158, 2) + Math.pow((cy - 168) / 150, 2) >= 1) continue;
      const inFace = oracleMirrorPointInFace(cx, cy);
      if (!inFace && !oracleMirrorPointInCombField(cx, cy)) continue;
      const shape = inFace ? oracleMirrorCellShapeForPoint(cx, cy, row, col) : 'backdrop';
      const phase = oracleMirrorCellPhaseForPoint(cx, cy, row, col, shape);
      const localRadius = shape === 'eye' ? 10.2 : shape === 'voice' ? 9.4 : shape === 'backdrop' ? 8.6 : radius;
      specs.push([Number(cx.toFixed(1)), Number(cy.toFixed(1)), localRadius, phase, shape, row, col]);
    }
  }
  return specs;
}

function oracleMirrorPointInCombField(cx, cy) {
  return Math.pow((cx - 180) / 158, 2) + Math.pow((cy - 168) / 150, 2) < 1;
}

function oracleMirrorPointInFace(cx, cy) {
  const ax = Math.abs(cx - 180);
  const head = Math.pow(ax / 72, 2) + Math.pow((cy - 160) / 82, 2) < 1;
  const jaw = cy >= 196 && cy < 252 && ax < 62 - (cy - 196) * 0.52;
  const crown = cy < 96 && ax < 16 + (cy - 78) * 0.95;
  return head || jaw || crown;
}

function oracleMirrorCellShapeForPoint(cx, cy, row, col) {
  const ax = Math.abs(cx - 180);
  if (Math.hypot((ax - 28) / 12, (cy - 150) / 10.5) < 1) return 'eye';
  if (cy > 128 && cy < 140 && ax > 12 && ax < 44) return 'brow';
  if (cy > 196 && cy < 226 && ax < 44) return 'voice';
  if (cy > 228) return 'jaw';
  if (oracleMirrorFaceEdge(cx, cy)) return 'edge';
  if (ax < 48 && cy > 104 && cy < 222) return 'face';
  return 'field';
}

function oracleMirrorCellPhaseForPoint(cx, cy, row, col, shape) {
  if (shape === 'backdrop') return 'idle';
  if (shape === 'eye' || shape === 'brow') return 'core';
  if (shape === 'voice') return row % 2 === 0 ? 'voice' : 'soft';
  if (shape === 'edge') return (row + Math.abs(col)) % 2 === 0 ? 'edge' : 'soft';
  if (shape === 'jaw') return Math.abs(col) % 2 === 0 ? 'edge' : 'soft';
  return ['a', 'b', 'c'][Math.abs(row + col) % 3];
}

function oracleMirrorFaceEdge(cx, cy) {
  return (
    oracleMirrorPointInFace(cx, cy) &&
    Math.pow((cx - 180) / 72, 2) + Math.pow((cy - 164) / 92, 2) > 0.6
  );
}

function oracleMirrorEyeCenters(cellSpecs) {
  const average = (cells, fallback) => {
    if (!cells.length) return fallback;
    const total = cells.reduce((acc, [x, y]) => ({x: acc.x + x, y: acc.y + y}), {x: 0, y: 0});
    return {x: Number((total.x / cells.length).toFixed(1)), y: Number((total.y / cells.length).toFixed(1))};
  };
  const left = cellSpecs.filter(([x, , , , shape]) => shape === 'eye' && x < 180);
  const right = cellSpecs.filter(([x, , , , shape]) => shape === 'eye' && x >= 180);
  return {
    left: average(left, {x: 153.6, y: 166.6}),
    right: average(right, {x: 205.9, y: 166.6}),
  };
}

function oracleMirrorCellLinks(cellSpecs) {
  const links = [];
  for (let sourceIndex = 0; sourceIndex < cellSpecs.length; sourceIndex += 1) {
    const [x1, y1, , , sourceShape] = cellSpecs[sourceIndex];
    for (let targetIndex = sourceIndex + 1; targetIndex < cellSpecs.length; targetIndex += 1) {
      const [x2, y2, , , targetShape] = cellSpecs[targetIndex];
      const dx = x2 - x1;
      const dy = y2 - y1;
      const distance = Math.sqrt(dx * dx + dy * dy);
      if (distance > 14 && distance < 20) {
        const linkShape = sourceShape === 'backdrop' || targetShape === 'backdrop' ? 'is-backdrop' : 'is-face';
        links.push(`<line class="mirror-cell-link ${linkShape}" style="--i:${links.length}" x1="${x1}" y1="${y1}" x2="${x2}" y2="${y2}"></line>`);
      }
    }
  }
  return links.join('');
}

function oracleMirrorCellActive(presence, phase, index, shape, row, col) {
  if (shape === 'backdrop') return false;
  if (shape === 'eye' || shape === 'brow' || shape === 'voice') return true;
  const coord = (row + Math.abs(col)) % 2 === 0;
  if (presence === 'listening') return shape === 'edge' || shape === 'jaw' || (shape === 'field' && coord);
  if (presence === 'thinking') return phase !== 'c' || index % 5 === 0;
  if (presence === 'speaking') return shape !== 'backdrop' && (shape !== 'field' || coord || index % 3 === 0);
  if (presence === 'blocked' || presence === 'error') return shape === 'edge' || shape === 'jaw' || (shape === 'field' && index % 9 === 0);
  return shape === 'edge' || shape === 'jaw' || shape === 'face' || (shape === 'field' && index % 8 === 0);
}

function oracleMirrorCellStatus(presence, index, shape, row, col) {
  if (shape === 'eye') return true;
  if (presence === 'speaking') return shape === 'voice' && Math.abs(col) <= 2;
  if (presence === 'listening') return (shape === 'edge' || shape === 'jaw') && (index + Math.abs(row)) % 7 === 0;
  if (presence === 'thinking') return shape === 'field' && (index + Math.abs(col)) % 13 === 0;
  if (presence === 'blocked' || presence === 'error') return shape === 'edge' && (index + row) % 5 === 0;
  return shape === 'brow' && Math.abs(col) <= 3;
}

function renderOracleMirror() {
  if (!oracleMirror || !oracleStage) return;
  const presence = oracleStage.dataset.presence || 'idle';
  if (oracleRenderedPresence === presence && oracleMirror.innerHTML) return;
  oracleRenderedPresence = presence;
  const cellSpecs = oracleMirrorCellSpecs();
  const eyeCenters = oracleMirrorEyeCenters(cellSpecs);
  const mouthCenterX = Number(((eyeCenters.left.x + eyeCenters.right.x) / 2).toFixed(1));
  const mouthCenterY = 205.5;
  const cells = cellSpecs.map(([cx, cy, r, phase, shape, row, col], index) => {
    const active = oracleMirrorCellActive(presence, phase, index, shape, row, col) ? ' is-active' : '';
    const status = active && oracleMirrorCellStatus(presence, index, shape, row, col) ? ' is-status' : '';
    const symIndex = Math.abs(col) * 13 + Math.abs(row);
    return `<polygon class="mirror-cell phase-${phase} shape-${shape}${active}${status}" data-cell-shape="${shape}" style="--i:${symIndex}; --cell-x:${cx}; --cell-y:${cy}; --cell-col:${Math.abs(col)}; --cell-row:${Math.abs(row)}" points="${oracleHexPoints(cx, cy, r)}"></polygon>`;
  }).join('');
  const voiceBars = Array.from({ length: 21 }, (_, index) => {
    const columnOffset = index - 10;
    const x = mouthCenterX + columnOffset * 5.9;
    const distance = Math.abs(columnOffset);
    const miniCells = Array.from({ length: 7 }, (_cell, cellIndex) => {
      const rowOffset = cellIndex - 3;
      const stagger = index % 2 === 0 ? 0 : 2.05;
      const y = mouthCenterY + rowOffset * 4.75 + stagger;
      return `<polygon class="mirror-speaking-cell cell-row-${cellIndex}" style="--slot:${cellIndex}; --cell-row-offset:${rowOffset}; --cell-column-offset:${columnOffset}; --cell-distance:${Math.abs(rowOffset)}; --column-distance:${distance}" points="${oracleHexPoints(x, y, 2.46)}"></polygon>`;
    }).join('');
    return `<g class="mirror-speaking-bar" style="--i:${index}; --audio-scale:0; --audio-opacity:0.02">${miniCells}</g>`;
  }).join('');
  const waveCells = Array.from({ length: 41 }, (_, index) => {
    const pointOffset = index - 20;
    const spread = Math.abs(pointOffset) / 20;
    const amplitude = 7.2 * (1 - spread * 0.44);
    const x = mouthCenterX + pointOffset * 3.15;
    const y = mouthCenterY - 0.9 + Math.sin(index * 0.78) * amplitude;
    return `<polygon class="mirror-wave-cell" style="--i:${index}; --wave-distance:${spread.toFixed(2)}" points="${oracleHexPoints(x, y, 1.98)}"></polygon>`;
  }).join('');
  oracleMirror.innerHTML = `
    <div class="mirror-glass">
      <svg class="mirror-svg" viewBox="0 0 360 360" role="presentation" focusable="false">
        <defs>
          <radialGradient id="ms4OracleMirrorCore" cx="50%" cy="42%" r="58%">
            <stop offset="0%" stop-color="rgba(245,242,255,0.22)"></stop>
            <stop offset="48%" stop-color="rgba(168,85,255,0.12)"></stop>
            <stop offset="100%" stop-color="rgba(2,2,4,0)"></stop>
          </radialGradient>
        </defs>
        <circle class="mirror-aura" cx="180" cy="172" r="128"></circle>
        <circle class="mirror-core" cx="180" cy="174" r="96"></circle>
        <path class="mirror-face-energy" d="M180 70 C143 80 122 116 124 166 C126 219 151 261 180 282 C209 261 234 219 236 166 C238 116 217 80 180 70 Z"></path>
        <g class="mirror-cell-links">${oracleMirrorCellLinks(cellSpecs)}</g>
        <g class="mirror-cells">${cells}</g>
        <g class="mirror-wave mirror-wave-cells">${waveCells}</g>
        <g class="mirror-speaking-bars">${voiceBars}</g>
        <path class="mirror-face-outline" d="M180 70 C143 80 122 116 124 166 C126 219 151 261 180 282 C209 261 234 219 236 166 C238 116 217 80 180 70 Z"></path>
        <g class="mirror-eyes">
          <g class="mirror-eye-rings">
            <polygon points="${oracleHexPoints(eyeCenters.left.x, eyeCenters.left.y, 18)}"></polygon>
            <polygon points="${oracleHexPoints(eyeCenters.right.x, eyeCenters.right.y, 18)}"></polygon>
          </g>
          <polygon points="${oracleHexPoints(eyeCenters.left.x, eyeCenters.left.y, 11)}"></polygon>
          <polygon points="${oracleHexPoints(eyeCenters.right.x, eyeCenters.right.y, 11)}"></polygon>
          <circle cx="${eyeCenters.left.x}" cy="${eyeCenters.left.y}" r="3.3"></circle>
          <circle cx="${eyeCenters.right.x}" cy="${eyeCenters.right.y}" r="3.3"></circle>
        </g>
      </svg>
    </div>
  `;
  oracleMirror.dataset.presence = presence;
  oracleMirror.dataset.audioReactive = oracleStage.dataset.audioReactive || 'false';
  startOraclePresenceAnimation();
}

