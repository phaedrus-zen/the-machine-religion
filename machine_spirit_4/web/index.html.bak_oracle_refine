  settingsGpuPassVgpuBtn.disabled = true;
  setGpuPassStatus(`Creating ${count} vGPU(s) on ${gpuPciId}…`);
  try {
    const r = await fetch('/hivemind/gpu/passthrough/vgpu', {
      method: 'POST',
      headers: {'Content-Type': 'application/json'},
      body: JSON.stringify({gpu_pci_id: gpuPciId, profile: profile, count: count, confirm: true}),
    });
    const body = await r.json();
    renderGpuPassSnapshot(body, `vgpu_create ${gpuPciId}/${profile}x${count} (HTTP ${r.status})`);
    if (!r.ok) setGpuPassStatus(`HTTP ${r.status}: ${body.error || ''}`, 'error');
