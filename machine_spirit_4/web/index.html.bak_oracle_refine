          <input id="settingsGpuPassPrepPciId" type="text" placeholder="PCI ID (e.g. 0000:01:00.0)" style="flex:1; min-width:160px;">
          <select id="settingsGpuPassPrepMode" style="background:#1a1a2e; color:#fff; border:1px solid #2d2d44; padding:4px;">
            <option value="passthrough">passthrough (DDA)</option>
            <option value="vgpu">vgpu (NVIDIA vGPU)</option>
          </select>
          <button type="button" id="settingsGpuPassPrepBtn" class="secondary">Prepare mode</button>
        </div>
      </div>
    </details>

    <details style="margin-top:8px;">
