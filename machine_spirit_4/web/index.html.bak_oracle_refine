function handleSseEvent(eventName, eventData, state) {
  if (eventName === 'token') {
    state.text += eventData.text || '';
    state.textNode.nodeValue = state.text || '...';
    setOracleStageState('speaking', state.text || 'Oracle is responding.', 'Text stream active.');
    messages.scrollTop = messages.scrollHeight;
    return;
  }
  if (eventName === 'heartbeat' || eventName === 'status') {
    statusEl.textContent = eventData.status === 'running' ? 'MS4 is thinking...' : 'MS4 stream started';
    setOracleStageState('thinking', 'Oracle is composing.', 'Face Lobe foreground is active.');
    return;
  }
  if (eventName === 'done') {
    sessionId = eventData.session_id;
    localStorage.setItem('ms4_session_id', sessionId);
    sessionEl.textContent = sessionId;
    if (!state.text && eventData.text) {
      state.text = eventData.text;
      state.textNode.nodeValue = state.text;
    }
    finishAssistantMessage(state.el, eventData);
    statusEl.textContent = 'Hermes + ms4_consciousness ready';
    setOracleStageState('idle', state.text || 'Ready.', '');
    return 'done';
  }
  if (eventName === 'error') {
    const suffix = eventData.model_incompatible ? ' Choose a model with at least 64K context or use the default.' : '';
    throw new Error((eventData.error || 'stream failed') + suffix);
  }
}

async function sendStreamingChat(text) {
  const state = createStreamingAssistantMessage();
  state.text = '';
  const r = await fetch('/chat/stream', {
    method: 'POST',
    headers: {'Content-Type': 'application/json'},
    body: JSON.stringify({message: text, session_id: sessionId, model_id: modelSelect.value, depth_model_id: depthModelSelect.value})
  });
  if (!r.ok || !r.body) {
    throw new Error(`stream failed: ${r.statusText}`);
  }
  const reader = r.body.getReader();
  const decoder = new TextDecoder();
  let buffer = '';
  while (true) {
    const {value, done} = await reader.read();
    if (done) break;
    buffer += decoder.decode(value, {stream: true});
    const frames = buffer.split('\n\n');
    buffer = frames.pop() || '';
    for (const frame of frames) {
      if (!frame.trim()) continue;
      let eventName = 'message';
      let dataText = '';
      for (const line of frame.split('\n')) {
        if (line.startsWith('event: ')) eventName = line.slice(7).trim();
        if (line.startsWith('data: ')) dataText += line.slice(6);
      }
      const eventData = dataText ? JSON.parse(dataText) : {};
      const terminal = handleSseEvent(eventName, eventData, state);
      if (terminal) return;
    }
  }
}

document.getElementById('chatForm').addEventListener('submit', async event => {
  event.preventDefault();
  const input = document.getElementById('messageInput');
  const text = input.value.trim();
  if (!text) return;
  // Barge-in: any new user input (text or voice) pre-empts whatever
  // is currently being said. Without this the audio from the prior
  // turn overlaps the new turn's audio (observed live).
  bargeIn('new chat turn');
  input.value = '';
  addMessage('user', text);
  setOracleStageTranscript(text, 'You');
  setOracleStageState('thinking', 'Oracle is composing.', 'Face Lobe foreground is active.');
  document.getElementById('sendButton').disabled = true;
  try {
    if (streamToggle.checked) await sendStreamingChat(text);
    else await sendBlockingChat(text);
  } catch (error) {
    addMessage('assistant', `Error: ${error.message}`);
    setOracleStageState('error', `Error: ${error.message}`, 'Chat path needs attention.');
  } finally {
    document.getElementById('sendButton').disabled = false;
  }
});

