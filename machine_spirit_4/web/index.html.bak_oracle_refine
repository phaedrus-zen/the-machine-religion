const micButton = document.getElementById('micButton');
const voiceStatusLine = document.getElementById('voiceStatusLine');
const voiceReplyAudio = document.getElementById('voiceReplyAudio');

// We deliberately do NOT use MediaRecorder. MediaRecorder defaults to
// WebM/Opus and HiveMind's ASR pipeline requires FFmpeg to decode any
// non-WAV format. Capturing raw PCM via AudioContext and encoding a WAV
// blob in the browser keeps the pipeline FFmpeg-free.
const TARGET_SAMPLE_RATE = 16000; // whisper-1's preferred input
let audioContext = null;
let mediaStream = null;
let audioInput = null;
let recorder = null;
let recordedChunks = [];
let recordingSourceSampleRate = 0;
let recordingStartedAt = 0;

function setVoiceStatus(text, kind) {
  voiceStatusLine.textContent = text || '';
  voiceStatusLine.style.color = kind === 'error' ? '#ef4444' : (kind === 'ok' ? '#22c55e' : '#9999b4');
  setOracleStageFromVoiceStatus(text, kind);
}

// Preferred mic constraints: mono + echo/noise processing. These can
// fail on some devices (OverconstrainedError) and a stale/changed
// default device can throw NotFoundError even when a mic exists, so
// acquireMicStream() retries once with bare {audio:true} before giving
// up. (function declaration -> hoisted, so earlier call sites can use it.)
const MIC_PREFERRED_CONSTRAINTS = {audio: {channelCount: 1, echoCancellation: true, noiseSuppression: true}};

async function acquireMicStream() {
  try {
    return await navigator.mediaDevices.getUserMedia(MIC_PREFERRED_CONSTRAINTS);
  } catch (err) {
    const name = err && err.name;
    if (name === 'OverconstrainedError' || name === 'NotFoundError' || name === 'NotReadableError') {
      // Relax constraints and retry once — handles over-constrained
      // devices and stale default-device races (the "Requested device
      // not found" case where a mic actually IS present).
      return await navigator.mediaDevices.getUserMedia({audio: true});
    }
    throw err;
  }
}

// Map a getUserMedia failure to an ACCURATE, actionable message. The old
// code labeled every failure "permission denied", which sent users
// hunting for a permission toggle when the real problem was no device or
// a device held by another app.
function micErrorMessage(error) {
  const name = (error && error.name) || '';
  const detail = (error && error.message) || String(error);
  if (name === 'NotAllowedError' || name === 'SecurityError') {
    return `Microphone blocked — allow mic access for this page (browser address bar / OS privacy settings). [${detail}]`;
  }
  if (name === 'NotFoundError' || name === 'OverconstrainedError' || name === 'DevicesNotFoundError') {
    return `No microphone found — check a mic is plugged in, enabled, and selected as the input device. [${detail}]`;
  }
  if (name === 'NotReadableError' || name === 'TrackStartError') {
    return `Microphone is busy — another app (Zoom/Teams/OBS/browser tab) may have it locked. Close it and retry. [${detail}]`;
  }
  return `Microphone error: ${detail}`;
}

async function startRecording() {
  if (recorder) return; // already recording
  try {
    mediaStream = await acquireMicStream();
  } catch (error) {
    setVoiceStatus(micErrorMessage(error), 'error');
    return;
  }
  try {
    audioContext = new (window.AudioContext || window.webkitAudioContext)();
    if (audioContext.state === 'suspended') await audioContext.resume();
    recordingSourceSampleRate = audioContext.sampleRate;
    audioInput = audioContext.createMediaStreamSource(mediaStream);
    // ScriptProcessorNode is deprecated but still universally supported and
    // the simplest path to capture PCM samples without an AudioWorklet
    // module file. Buffer size 4096 ≈ 90 ms blocks at 48 kHz.
    recorder = audioContext.createScriptProcessor(4096, 1, 1);
    recordedChunks = [];
    recorder.onaudioprocess = (event) => {
      const channelData = event.inputBuffer.getChannelData(0);
      // Copy because the underlying buffer is reused.
      recordedChunks.push(new Float32Array(channelData));
    };
    audioInput.connect(recorder);
    // ScriptProcessor only fires audioprocess if it has a downstream
    // connection. Pipe to a silent gain so we don't echo to speakers.
    const silentGain = audioContext.createGain();
    silentGain.gain.value = 0;
    recorder.connect(silentGain);
    silentGain.connect(audioContext.destination);
  } catch (error) {
    setVoiceStatus(`AudioContext init failed: ${error.message || error}`, 'error');
    teardownRecording();
    return;
  }
  recordingStartedAt = Date.now();
  micButton.setAttribute('aria-pressed', 'true');
  micButton.textContent = '⏺';
  setVoiceStatus('Recording… release to send', null);
  setOracleStageState('listening', 'Listening.', 'Release the mic to send this turn.');
  setOracleStageTranscript('');
}

function teardownRecording() {
  if (recorder) try { recorder.disconnect(); } catch (e) { /* ignore */ }
  if (audioInput) try { audioInput.disconnect(); } catch (e) { /* ignore */ }
  if (mediaStream) mediaStream.getTracks().forEach(t => { try { t.stop(); } catch (e) {} });
  if (audioContext && audioContext.state !== 'closed') {
    try { audioContext.close(); } catch (e) { /* ignore */ }
  }
  recorder = null;
  audioInput = null;
  mediaStream = null;
  audioContext = null;
}

function concatenateFloat32(chunks) {
  let total = 0;
  for (const buf of chunks) total += buf.length;
  const out = new Float32Array(total);
  let offset = 0;
  for (const buf of chunks) {
    out.set(buf, offset);
    offset += buf.length;
  }
  return out;
}

function downsampleTo(samples, sourceRate, targetRate) {
  if (sourceRate === targetRate || sourceRate < targetRate) return samples;
  const ratio = sourceRate / targetRate;
  const outLength = Math.floor(samples.length / ratio);
  const out = new Float32Array(outLength);
  // Simple averaging downsample to reduce aliasing without a full filter.
  for (let i = 0; i < outLength; i++) {
    const start = Math.floor(i * ratio);
    const end = Math.floor((i + 1) * ratio);
    let sum = 0;
    let count = 0;
    for (let j = start; j < end && j < samples.length; j++) {
      sum += samples[j];
      count++;
    }
    out[i] = count > 0 ? sum / count : 0;
  }
  return out;
}

function encodeWavBlob(float32Samples, sampleRate) {
  const numSamples = float32Samples.length;
  const buffer = new ArrayBuffer(44 + numSamples * 2);
  const view = new DataView(buffer);
  const writeStr = (offset, str) => {
    for (let i = 0; i < str.length; i++) view.setUint8(offset + i, str.charCodeAt(i));
  };
  // RIFF header
  writeStr(0, 'RIFF');
  view.setUint32(4, 36 + numSamples * 2, true);
  writeStr(8, 'WAVE');
  // fmt subchunk: PCM 16-bit mono
  writeStr(12, 'fmt ');
  view.setUint32(16, 16, true);
  view.setUint16(20, 1, true);             // PCM format
  view.setUint16(22, 1, true);             // 1 channel
  view.setUint32(24, sampleRate, true);
  view.setUint32(28, sampleRate * 2, true); // byte rate
  view.setUint16(32, 2, true);             // block align
  view.setUint16(34, 16, true);            // bits per sample
  // data subchunk
  writeStr(36, 'data');
  view.setUint32(40, numSamples * 2, true);
  let offset = 44;
  for (let i = 0; i < numSamples; i++) {
    let s = Math.max(-1, Math.min(1, float32Samples[i]));
    view.setInt16(offset, s < 0 ? s * 0x8000 : s * 0x7FFF, true);
    offset += 2;
  }
  return new Blob([buffer], {type: 'audio/wav'});
}

// =====================================================================
// Streaming audio playback with barge-in support
// =====================================================================
//
// Goals:
//   1. Sentence-chunked TTS plays seamlessly within one turn (existing).
//   2. When the user starts a new turn (mic press OR Send), the
//      currently-playing audio STOPS immediately — no overlap.
//   3. Late-arriving audio_chunk events from a barged turn are dropped
//      instead of being scheduled on top of the new turn.
//   4. Any in-flight /voice/turn/stream fetch is aborted on barge-in
//      so the server stops spending HiveMind cycles on audio nobody
//      is listening to.
//
// Implementation:
//   - `activeAudioSources` tracks every live AudioBufferSourceNode so
//     we can call .stop() on each.
//   - `currentVoiceTurnId` is a monotonic counter. Each turn captures
//     its id; the audio_chunk handler refuses to enqueue when its
//     captured id doesn't match the current one (= it was barged).
//   - `activeVoiceStreamController` holds the AbortController for the
//     in-flight fetch; barge-in calls .abort() to kill the SSE reader.
let playbackCtx = null;
let playbackAudioUnlocked = false;
let nextChunkStartTime = 0;
let activeAudioSources = [];
// Initial prebuffer (jitter buffer) state — see PREBUFFER_* constants.
let prebufferQueue = [];
let prebufferTimer = null;
let playbackRunStarted = false;
let currentVoiceTurnId = 0;
let activeVoiceStreamController = null;
// True once the operator has used voice this page-session (PTT or
// full-duplex). Gates the PROACTIVE SPOKEN delivery of deep-job
// completions: in a hands-free conversation the silent chat bubble
// isn't enough — the agent must speak up on its own when background
// work finishes. Text-only users still get the visual bubble.
let voiceModeActive = false;

function markOraclePlaybackActive() {
  clearOracleIdleTimer();
  if (oracleStage && oracleStage.dataset.presence !== 'speaking') {
    setOracleStageState('speaking', 'Oracle is speaking.', 'Voice playback active.');
  }
}

function scheduleOracleIdleAfterPlayback(subtitle, detail) {
  clearOracleIdleTimer();
  const remainingMs = playbackCtx ? Math.max(0, (nextChunkStartTime - playbackCtx.currentTime) * 1000) : 0;
  const waitMs = Math.max(360, Math.min(6000, remainingMs + 220));
  oracleIdleAfterPlaybackTimer = setTimeout(() => {
    const now = playbackCtx ? playbackCtx.currentTime : 0;
    const stillPlaying = activeAudioSources.some(entry => (entry.endAt || 0) > now + 0.05) || prebufferQueue.length > 0;
    if (stillPlaying) {
      scheduleOracleIdleAfterPlayback(subtitle, detail);
      return;
    }
    setOracleStageState('idle', subtitle || 'Ready.', detail || '');
  }, waitMs);
}

function unlockPlaybackAudio() {
  playbackAudioUnlocked = true;
  if (playbackCtx && playbackCtx.state === 'suspended') {
    playbackCtx.resume().catch(() => {});
  }
}

['pointerdown', 'keydown', 'touchstart'].forEach(eventName => {
  window.addEventListener(eventName, unlockPlaybackAudio, {capture: true, passive: true});
});

function canResumePlaybackAudio() {
  return playbackAudioUnlocked || !!(navigator.userActivation && navigator.userActivation.hasBeenActive);
}

function getPlaybackCtx() {
  if (!playbackCtx) {
    playbackCtx = new (window.AudioContext || window.webkitAudioContext)();
  }
  if (playbackCtx.state === 'suspended' && canResumePlaybackAudio()) {
    playbackCtx.resume().catch(() => {});
  }
  return playbackCtx;
}

// Soft tail-off window for half-context cancellation. MS4 lets a
// source that's currently in the middle of playing finish up to this
// many ms BEYOND the barge-in moment so the user hears a graceful
// trail instead of a mid-syllable click. Anything beyond this gets
// stopped immediately.
const HALF_CONTEXT_TAIL_MS = 250;

// Lead-time buffer for streaming TTS playback. When a new chunk
// arrives, we schedule it at max(nextChunkStartTime, currentTime +
// AUDIO_LEAD_TIME_MS). The lead time means slightly later chunks
// (~80-120ms network/decode jitter) have a slot waiting, so audio
// stays continuous instead of having audible gaps between word
// fragments. Adds ~150ms to first-audio latency but eliminates the
// "stutter at sentence boundaries" the operator reported live.
const AUDIO_LEAD_TIME_MS = 150;
// Initial prebuffer (jitter buffer). A short reply often ships a tiny
// first chunk ("Hey") whose audio finishes BEFORE the second chunk's TTS
// arrives, leaving an audible gap between the first and second words. So
// we HOLD the first chunk(s) of each turn until one of:
//   * a second chunk is decoded (PREBUFFER_MIN_CHUNKS) — now we can chain
//     them gaplessly, OR
//   * the buffered audio already covers PREBUFFER_TARGET_MS (the first
//     chunk is long enough to mask the next chunk's arrival on its own,
//     so don't add latency), OR
//   * PREBUFFER_MAX_MS elapses (a one-chunk reply still plays promptly;
//     the stream's `done` event also flushes immediately).
// Then everything plays back-to-back with no gap.
const PREBUFFER_MIN_CHUNKS = 2;
const PREBUFFER_TARGET_MS = 900;
const PREBUFFER_MAX_MS = 400;

function bargeIn(reason, options) {
  const opts = options || {};
  const halfContext = opts.halfContext === true;
  const playAck = opts.playAck === true;
  // keepStream: this is a CONTINUATION of the same utterance (the user
  // paused briefly then resumed). Stop the reply audio so it doesn't talk
  // over them, but DON'T abort the in-flight fetch or bump the turn id —
  // that lets the prior turn's transcript still render so nothing is lost.
  const keepStream = opts.keepStream === true;
  const now = playbackCtx ? playbackCtx.currentTime : 0;
  const tailOff = HALF_CONTEXT_TAIL_MS / 1000;

  // 1. Decide per-source whether to stop immediately or let tail off.
  //    For half-context: if the source is currently in mid-play, give
  //    it up to HALF_CONTEXT_TAIL_MS more to finish its current word
  //    or syllable instead of cutting abruptly. Sources scheduled in
  //    the FUTURE (queued chunks that haven't started) always cancel
  //    immediately — no point letting them in just to clip them.
  const kept = [];
  for (const entry of activeAudioSources.splice(0)) {
    const source = entry.source || entry;
    const startAt = entry.startAt != null ? entry.startAt : now;
    const endAt = entry.endAt != null ? entry.endAt : now;
    if (halfContext && playbackCtx && startAt <= now && endAt > now) {
      // Currently playing — stop at min(endAt, now + tailOff).
      const stopAt = Math.min(endAt, now + tailOff);
      try { source.stop(stopAt); } catch (e) { /* already stopped */ }
      kept.push(entry);
      continue;
    }
    try { source.stop(); } catch (e) { /* already finished */ }
    try { source.disconnect(); } catch (e) { /* fine */ }
  }
  // Put any "still tailing off" sources back into the list so
  // onended cleanup still fires for them.
  activeAudioSources = kept;

  // Reset the schedule cursor. New chunks (if any) start fresh.
  if (playbackCtx) {
    nextChunkStartTime = halfContext ? Math.min(now + tailOff, nextChunkStartTime) : now;
  } else {
    nextChunkStartTime = 0;
  }
  // Reset the prebuffer so the next turn re-buffers its first chunk(s)
  // and any chunks held for the barged turn are discarded.
  playbackRunStarted = false;
  prebufferQueue = [];
  if (prebufferTimer) { clearTimeout(prebufferTimer); prebufferTimer = null; }
  resetOraclePlaybackSignal();
  // Kill any lingering "thinking" ambience from the turn being interrupted.
  stopThinkingAmbient();

  // 2. Cancel the in-flight stream fetch so the SSE reader stops
  //    enqueuing more chunks AND the server-side worker can detect
  //    a closed client and bail out (saves HiveMind cycles).
  //    On a CONTINUATION we keep the stream so the prior transcript
  //    still lands (no truncation/loss of the first part).
  if (!keepStream && activeVoiceStreamController) {
    try { activeVoiceStreamController.abort(); } catch (e) {}
    activeVoiceStreamController = null;
  }

  // 3. Bump the turn id so any chunks already in-flight get dropped
  //    when they arrive at enqueueAudioChunk. (Skipped on continuation.)
  if (!keepStream) {
    currentVoiceTurnId += 1;
  }

  // 4. Optional canned ack played from the pre-rendered reflex
  //    catalog. Used by the full-duplex / VAD path to make the
  //    interruption feel instant — the user hears "Mhm?" the moment
  //    they start speaking, before ASR even has the first byte.
  if (playAck) {
    playRandomReflexAck();
  }

  if (reason) {
    setVoiceStatus(`Interrupted (${reason}) — listening`, null);
    setOracleStageState('listening', 'Interrupted. Listening now.', reason);
  }
}

function playRandomReflexAck() {
  // The reflex catalog is preloaded into AudioBuffer instances by
  // refreshReflexCatalog(). We pick a random ack-category id and
  // play it via playReflex(). The ack reflexes are intentionally
  // short (≤1s) so they don't compete with the user's incoming
  // speech.
  const ackIds = ['ack_mhm', 'ack_yes', 'ack_go_ahead', 'ack_listening'];
  const eligible = ackIds.filter(id => reflexBuffers.has(id));
  if (eligible.length === 0) return;
  const choice = eligible[Math.floor(Math.random() * eligible.length)];
  try { playReflex(choice); } catch (e) { /* never let an ack failure break the turn */ }
}

// A soft, very short, low-volume "heard you" earcon played the instant
// the user starts speaking in full-duplex. Replaces the old spoken ack
// ("Mhm?" / "I'm listening.") that fired ~160ms into the first word and
// talked OVER the user. Pure Web Audio — no asset, no round-trip, ~5ms to
// schedule. A gentle rising sine pip at ~ -26 dB: noticeable but it never
// competes with speech. Spoken acknowledgments now happen AFTER the user
// finishes (server-driven, context-aware `reflex` event).
function playOnsetTick() {
  try {
    const ctx = getPlaybackCtx();
    const t0 = ctx.currentTime + 0.005;
    const osc = ctx.createOscillator();
    const gain = ctx.createGain();
    osc.type = 'sine';
    osc.frequency.setValueAtTime(620, t0);
    osc.frequency.exponentialRampToValueAtTime(880, t0 + 0.05);
    gain.gain.setValueAtTime(0.0001, t0);
    gain.gain.exponentialRampToValueAtTime(0.05, t0 + 0.015);  // soft attack
    gain.gain.exponentialRampToValueAtTime(0.0001, t0 + 0.11); // quick decay
    osc.connect(gain);
    gain.connect(ctx.destination);
    osc.start(t0);
    osc.stop(t0 + 0.13);
  } catch (e) { /* never let the tick break a turn */ }
}

// Bridge between turn-start and first-audio: when first audio is taking
// long (cold load, slow Face model, large reply), fill the dead air. The
// server's context-aware `reflex` event (tiny sentiment model) lands
// first (~1.5s) as the spoken acknowledgment; this bridge then starts a
// subtle high-fidelity "thinking" AMBIENCE underneath for the rest of the
// wait. Raised 1200 -> 1900ms so the spoken reflex usually wins the lead.
const THINKING_BRIDGE_DELAY_MS = 1900;
function playRandomThinkingReflex() {
  const ids = ['thinking_one_moment', 'thinking_let_me_check', 'thinking_working_on_it'];
  const eligible = ids.filter(id => reflexBuffers.has(id));
  if (eligible.length === 0) return false;
  const choice = eligible[Math.floor(Math.random() * eligible.length)];
  try { return !!playReflex(choice); } catch (e) { return false; }
}

// Optional non-speech "thinking" ambience generated in Web Audio: a very
// soft, slowly-breathing low pad. OFF by default (it was unwanted); opt in
// via Settings (localStorage `ms4_thinking_ambience`). Softened Jun 1 2026
// (lower gain, warmer low partials, gentler swell) so it's unobtrusive.
const THINKING_AMBIENCE_KEY = 'ms4_thinking_ambience';
function isThinkingAmbienceEnabled() {
  return localStorage.getItem(THINKING_AMBIENCE_KEY) === 'true';  // default OFF
}
let thinkingAmbient = null;

function startThinkingAmbient() {
  if (thinkingAmbient) return;
  try {
    const ctx = getPlaybackCtx();
    const now = ctx.currentTime;
    const master = ctx.createGain();
    master.gain.setValueAtTime(0.0001, now);
    master.gain.exponentialRampToValueAtTime(0.022, now + 0.6);  // softer fade-in, ~ -33 dB
    master.connect(ctx.destination);

    const lp = ctx.createBiquadFilter();
    lp.type = 'lowpass';
    lp.frequency.value = 520;   // warmer/darker -> less "hum" presence
    lp.Q.value = 0.5;
    lp.connect(master);

    const oscs = [];
    [110.0, 164.8, 220.0].forEach((f, i) => {  // lower octave -> gentler
      const o = ctx.createOscillator();
      o.type = 'sine';
      o.frequency.value = f;
      o.detune.value = (i - 1) * 3;
      const g = ctx.createGain();
      g.gain.value = i === 0 ? 0.6 : 0.25;
      o.connect(g); g.connect(lp);
      o.start(now);
      oscs.push(o);
    });

    // Very slow breathing swell on the master gain (~6s cycle).
    const lfo = ctx.createOscillator();
    lfo.type = 'sine';
    lfo.frequency.value = 0.16;
    const lfoGain = ctx.createGain();
    lfoGain.gain.value = 0.008;
    lfo.connect(lfoGain); lfoGain.connect(master.gain);
    lfo.start(now);

    thinkingAmbient = {
      stop() {
        try {
          const t = ctx.currentTime;
          master.gain.cancelScheduledValues(t);
          master.gain.setValueAtTime(Math.max(0.0002, master.gain.value || 0.04), t);
          master.gain.exponentialRampToValueAtTime(0.0001, t + 0.22);
          oscs.forEach(o => { try { o.stop(t + 0.28); } catch (e) {} });
          try { lfo.stop(t + 0.28); } catch (e) {}
        } catch (e) { /* fine */ }
      },
    };
  } catch (e) { thinkingAmbient = null; }
}

function stopThinkingAmbient() {
  if (thinkingAmbient) {
    try { thinkingAmbient.stop(); } catch (e) { /* fine */ }
    thinkingAmbient = null;
  }
}

// Easter egg: play the "Honorable" -> WE ON GO drop. Fetches the clip from
// the gateway (the browser can't read a local file path), decodes once,
// caches it, and plays the first `secs` with a smooth fade-out. Routed
// through activeAudioSources so barge-in can stop it. Falls back to the
// spoken "We on go!" reflex if the clip is unavailable (file missing).
let eggClipBuffer = null;

async function playEggClip(url, secs) {
  try {
    const ctx = getPlaybackCtx();
    stopThinkingAmbient();
    if (!eggClipBuffer) {
      const r = await fetch(url || '/easter/honorable', {cache: 'force-cache'});
      if (!r.ok) throw new Error('clip HTTP ' + r.status);
      eggClipBuffer = await ctx.decodeAudioData(await r.arrayBuffer());
    }
    const dur = Math.min(Math.max(1, secs || 9), eggClipBuffer.duration);
    const now = ctx.currentTime + 0.02;
    const src = ctx.createBufferSource();
    src.buffer = eggClipBuffer;
    const g = ctx.createGain();
    g.gain.setValueAtTime(0.9, now);
    g.gain.setValueAtTime(0.9, now + Math.max(0.1, dur - 0.6));  // hold, then fade
    g.gain.exponentialRampToValueAtTime(0.0001, now + dur);
    src.connect(g); g.connect(oraclePlaybackNodeForSource(ctx));
    src.start(now, 0, dur);  // play the first `dur` seconds (the intro)
    const entry = {source: src, startAt: now, endAt: now + dur};
    activeAudioSources.push(entry);
    markOraclePlaybackActive();
    src.onended = () => { activeAudioSources = activeAudioSources.filter(e => (e.source || e) !== src); };
    return true;
  } catch (e) {
    console.warn('egg clip failed; falling back to spoken line:', e);
    try { return playReflex('egg_honorable'); } catch (e2) { return false; }
  }
}

function resetPlaybackQueue() {
  // Legacy callers call this at start-of-turn. The new contract is
  // "start-of-turn always barges any prior audio" so route through
  // the barge-in machinery.
  bargeIn(null);
}

async function enqueueAudioChunk(audioB64, mime, turnId) {
  // Drop chunks from a turn that's already been barged. This is the
  // critical race: the SSE reader can still receive an audio_chunk
  // event AFTER bargeIn() ran (TCP buffering, decodeAudioData latency)
  // and without this check those chunks would play on top of the new
  // turn's audio.
  if (turnId !== undefined && turnId !== currentVoiceTurnId) {
    return;
  }
  try {
    const ctx = getPlaybackCtx();
    const binary = atob(audioB64);
    const buf = new Uint8Array(binary.length);
    for (let i = 0; i < binary.length; i++) buf[i] = binary.charCodeAt(i);
    const audioBuffer = await ctx.decodeAudioData(buf.buffer);
    // Re-check turn id AFTER the async decode — decoding takes ~10-30ms
    // and barge-in might have fired in between.
    if (turnId !== undefined && turnId !== currentVoiceTurnId) return;
    // Initial prebuffer: hold the first chunk(s) until the second is
    // ready (or the first is long enough / a short timeout) so the
    // first->second word gap disappears. Once the run is playing,
    // schedule live.
    if (!playbackRunStarted) {
      prebufferQueue.push({audioBuffer, turnId});
      const bufferedMs = prebufferQueue.reduce((s, it) => s + it.audioBuffer.duration, 0) * 1000;
      if (prebufferQueue.length >= PREBUFFER_MIN_CHUNKS || bufferedMs >= PREBUFFER_TARGET_MS) {
        flushPrebuffer();
      } else if (!prebufferTimer) {
        prebufferTimer = setTimeout(flushPrebuffer, PREBUFFER_MAX_MS);
      }
      return;
    }
    scheduleDecodedChunk(audioBuffer, turnId);
  } catch (err) {
    console.warn('audio chunk decode/play failed:', err);
  }
}

// Release the prebuffered chunks and commit this run to live playback.
function flushPrebuffer() {
  if (prebufferTimer) { clearTimeout(prebufferTimer); prebufferTimer = null; }
  playbackRunStarted = true;
  const items = prebufferQueue;
  prebufferQueue = [];
  for (const it of items) scheduleDecodedChunk(it.audioBuffer, it.turnId);
}

// Schedule one decoded chunk gaplessly behind whatever's already queued.
function scheduleDecodedChunk(audioBuffer, turnId) {
  // Barge-in may have fired while we were prebuffering — drop stale audio.
  if (turnId !== undefined && turnId !== currentVoiceTurnId) return;
  const ctx = getPlaybackCtx();
  const source = ctx.createBufferSource();
  source.buffer = audioBuffer;
  source.connect(oraclePlaybackNodeForSource(ctx));
  // If nextChunkStartTime is already ahead of currentTime + lead we honor
  // it (chunks are queueing back-to-back); otherwise we anchor to
  // currentTime + lead so the next chunk has room.
  const leadFloor = ctx.currentTime + (AUDIO_LEAD_TIME_MS / 1000);
  const startAt = Math.max(nextChunkStartTime, leadFloor);
  source.start(startAt);
  nextChunkStartTime = startAt + audioBuffer.duration;
  // Track start/end times alongside the node so half-context barge-in can
  // decide whether each source is "currently playing" (let it tail off)
  // vs "queued in the future" (cancel immediately).
  const entry = {source, startAt, endAt: startAt + audioBuffer.duration};
  activeAudioSources.push(entry);
  markOraclePlaybackActive();
  source.onended = () => {
    activeAudioSources = activeAudioSources.filter(e => (e.source || e) !== source);
  };
}

async function stopRecordingAndSend() {
  if (!recorder) {
    setVoiceStatus('', null);
    return;
  }
  const chunks = recordedChunks;
  const sourceRate = recordingSourceSampleRate;
  teardownRecording();
  micButton.setAttribute('aria-pressed', 'false');
  micButton.textContent = '🎤';
  recordedChunks = [];
  recordingSourceSampleRate = 0;
  if (chunks.length === 0) {
    setVoiceStatus('No audio captured', 'error');
    return;
  }
  const float32 = concatenateFloat32(chunks);
  const downsampled = downsampleTo(float32, sourceRate, TARGET_SAMPLE_RATE);
  const wavBlob = encodeWavBlob(downsampled, TARGET_SAMPLE_RATE);
  const durationSec = (Date.now() - recordingStartedAt) / 1000;
  await submitWavBlobAsVoiceTurn(wavBlob, {durationSec, sourceLabel: 'ptt'});
}

// Used by both push-to-talk (stopRecordingAndSend) and the full-duplex
// VAD loop (vadSpeechOffset). Owns the /voice/turn/stream POST, the
// SSE event loop, the assistant message rendering, and the barge-in
// race protection. Factored out so the VAD path doesn't reinvent any
// of it.
async function submitWavBlobAsVoiceTurn(wavBlob, options) {
  const opts = options || {};
  voiceModeActive = true;  // we're in a voice conversation -> speak completions
  const durationSec = opts.durationSec != null ? opts.durationSec : 0;
  const sourceLabel = opts.sourceLabel || 'voice';
  setVoiceStatus(
    `Captured ${wavBlob.size} bytes WAV (${durationSec.toFixed(1)}s @ ${TARGET_SAMPLE_RATE}Hz); streaming…`,
    null,
  );

  setOracleStageState(
    'thinking',
    'Voice captured. Routing through HiveMind.',
    `${sourceLabel.toUpperCase()} audio ${durationSec.toFixed(1)}s; waiting on ASR.`
  );
  setOracleStageTranscript('');

  const form = new FormData();
  form.append('file', wavBlob, 'mic.wav');
  const params = voiceQueryParams();
  const url = `/voice/turn/stream${params.toString() ? `?${params.toString()}` : ''}`;

  // Barge-in is the responsibility of the caller (PTT bargesIn full,
  // VAD onset already barged with halfContext). For PTT release this
  // additional barge is a no-op because we already barged on press;
  // doing it again is safe (idempotent).
  if (sourceLabel === 'ptt') {
    resetPlaybackQueue();
  } else {
    // The VAD onset path already barged with halfContext. Only reset
    // the playback cursor so new chunks start clean — don't kill the
    // active sources that are tailing off.
    if (playbackCtx) {
      nextChunkStartTime = playbackCtx.currentTime;
    }
  }
  // Capture our turn id AFTER the barge (resetPlaybackQueue bumps it).
  // The SSE reader checks myTurnId !== currentVoiceTurnId to drop
  // any audio_chunk events that arrive after a NEW turn started —
  // critical for the half-context overlap case where the next user
  // utterance can fire before this stream finishes.
  const myTurnId = currentVoiceTurnId;
  const turnStart = Date.now();
  const streamController = new AbortController();
  activeVoiceStreamController = streamController;

  let assistantState = null;     // {el, textNode, text}
  let transcriptShown = false;
  let firstAudioAt = null;
  // Refs so a late (async) `speaker` event can decorate the user bubble
  // after the transcript already shipped — speaker ID now runs off the
  // critical path so the transcript no longer waits on diarization.
  let voiceUserBubble = null;
  let voiceUserText = '';
  const accumulatedDeltas = [];
  // Schedule a "thinking" reflex if first audio is taking long
  // enough to feel awkward. Cleared the moment first audio plays
  // OR the turn aborts.
  let thinkingBridgeTimer = setTimeout(() => {
    if (firstAudioAt === null && currentVoiceTurnId === myTurnId && isThinkingAmbienceEnabled()) {
      // Optional soft ambience for the longer wait. OFF by default (the
      // spoken context reflex already covers the dead air, and the hum
      // was unwanted); opt in via Settings.
      startThinkingAmbient();
    }
  }, THINKING_BRIDGE_DELAY_MS);

  try {
    const r = await fetch(url, {method: 'POST', body: form, signal: streamController.signal});
    if (!r.ok || !r.body) {
      const body = await r.text().catch(() => '');
      throw new Error(`stream open failed: ${r.statusText} ${body.slice(0, 200)}`);
    }
    const reader = r.body.getReader();
    const decoder = new TextDecoder();
    let buffer = '';
    outer: while (true) {
      // Honor barge-in mid-stream: if a newer turn started, stop reading.
      if (myTurnId !== currentVoiceTurnId) break;
      const {value, done} = await reader.read();
      if (done) break;
      buffer += decoder.decode(value, {stream: true});
      const frames = buffer.split('\n\n');
      buffer = frames.pop() || '';
      for (const frame of frames) {
        if (!frame.trim()) continue;
        let eventName = 'message';
        let dataText = '';
        for (const line of frame.split('\n')) {
          if (line.startsWith('event: ')) eventName = line.slice(7).trim();
          if (line.startsWith('data: ')) dataText += line.slice(6);
        }
        let payload = {};
        try { payload = dataText ? JSON.parse(dataText) : {}; }
        catch (e) { continue; }

        if (eventName === 'status') {
          const phase = payload.phase || payload.status;
          if (phase === 'transcribing') {
            setOracleStageState('thinking', 'Transcribing your voice.', 'ASR is producing text.');
          } else if (phase === 'thinking') {
            setOracleStageState('thinking', 'Oracle is composing.', 'Face Lobe foreground is preparing the reply.');
          }
          if (phase === 'transcribing') setVoiceStatus('Transcribing…', null);
          else if (phase === 'thinking') setVoiceStatus('Thinking…', null);
        } else if (eventName === 'transcript') {
          // Decorate the user bubble with the speaker name when
          // hivemind.voice_identities.identify@v1 returned a match
          // above the confidence threshold. We keep the 🎤 marker
          // so it's still obviously a voice turn.
          const speaker = payload.speaker;
          const speakerName = (speaker && speaker.accepted && speaker.name) ? speaker.name : null;
          voiceUserText = payload.text || '';
          const userText = speakerName
            ? `🎤 ${speakerName}: ${voiceUserText}`
            : `🎤 ${voiceUserText}`;
          voiceUserBubble = addMessage('user', userText);
          assistantState = createStreamingAssistantMessage();
          assistantState.text = '';
          transcriptShown = true;
          const asrLine = `Transcribed in ${payload.asr_ms ?? '?'}ms`;
          setOracleStageTranscript(voiceUserText, speakerName);
          setOracleStageState('thinking', 'I heard you. Preparing the response.', asrLine);
          const speakerLine = speakerName
            ? ` · speaker ${speakerName} (${Math.round((speaker.score || 0) * 100)}%)`
            : '';
          setVoiceStatus(`${asrLine}${speakerLine} — streaming reply…`, null);
        } else if (eventName === 'speaker') {
          // Late speaker-ID result (diarization now runs off the critical
          // path, so it lands after the transcript). Decorate the existing
          // user bubble in place rather than blocking the turn on it.
          const speaker = payload.speaker;
          const speakerName = (speaker && speaker.accepted && speaker.name) ? speaker.name : null;
          if (speakerName && voiceUserBubble) {
            setOracleStageTranscript(voiceUserText, speakerName);
            voiceUserBubble.textContent = `🎤 ${speakerName}: ${voiceUserText}`;
          }
        } else if (eventName === 'reflex') {
          // Server-chosen, context-aware "buying time" acknowledgment
          // (tiny sentiment model -> fitting, varied canned phrase). Play
          // it during the dead air, but only if the real reply audio
          // hasn't already started. Replaces the old random thinking
          // reflex; cancel that timer so they don't double up.
          if (firstAudioAt === null && currentVoiceTurnId === myTurnId && payload.id) {
            if (thinkingBridgeTimer) { clearTimeout(thinkingBridgeTimer); thinkingBridgeTimer = null; }
            setOracleStageState('thinking', payload.label || 'One moment.', 'Reflex audio is covering the wait.');
            playReflex(payload.id);
          }
        } else if (eventName === 'egg') {
          // Easter egg fired (Honorable -> WE ON GO). It REPLACES the
          // reply: stop any dead-air cues and play the clip. firstAudioAt
          // is set so the bridge/ambience can't fire on top of it.
          if (currentVoiceTurnId === myTurnId) {
            if (thinkingBridgeTimer) { clearTimeout(thinkingBridgeTimer); thinkingBridgeTimer = null; }
            firstAudioAt = Date.now() - turnStart;
            setVoiceStatus(payload.label || 'Honorable... we on go', 'ok');
            playEggClip(payload.clip, payload.secs);
          }
        } else if (eventName === 'text_delta') {
          if (!assistantState) {
            assistantState = createStreamingAssistantMessage();
            assistantState.text = '';
          }
          assistantState.text += payload.text || '';
          assistantState.textNode.nodeValue = assistantState.text || '…';
          messages.scrollTop = messages.scrollHeight;
          accumulatedDeltas.push(payload.text || '');
          setOracleStageState(
            firstAudioAt === null ? 'thinking' : 'speaking',
            assistantState.text || 'Oracle is responding.',
            firstAudioAt === null ? 'Text is streaming; waiting for first audio.' : `Audio started in ${firstAudioAt}ms.`
          );
        } else if (eventName === 'chunk_scheduled') {
          // optional: visualize backlog
        } else if (eventName === 'audio_chunk') {
          if (firstAudioAt === null) {
            firstAudioAt = Date.now() - turnStart;
            setVoiceStatus(`First audio in ${firstAudioAt}ms`, 'ok');
            setOracleStageState('speaking', 'Oracle is speaking.', `First audio in ${firstAudioAt}ms.`);
            // Real audio has arrived; cancel the thinking bridge and stop
            // the ambience so neither plays on top of the actual reply.
            if (thinkingBridgeTimer) {
              clearTimeout(thinkingBridgeTimer);
              thinkingBridgeTimer = null;
            }
            stopThinkingAmbient();
          }
          // Pass myTurnId so the chunk is dropped if barge-in already fired.
          await enqueueAudioChunk(payload.audio_base64, payload.audio_mime || 'audio/wav', myTurnId);
        } else if (eventName === 'audio_error') {
          console.warn('audio_error for chunk', payload.index, payload.error);
          setOracleStageState('blocked', 'Audio chunk failed.', payload.error || `chunk ${payload.index}`);
        } else if (eventName === 'done') {
          // The reply is complete — release any still-held prebuffer
          // immediately so a short (one-chunk) reply plays without
          // waiting out the prebuffer timeout.
          if (!playbackRunStarted && prebufferQueue.length) flushPrebuffer();
          if (payload.session_id) {
            sessionId = payload.session_id;
            localStorage.setItem('ms4_session_id', sessionId);
            sessionEl.textContent = sessionId;
          }
          if (assistantState) {
            const finalText = (payload.reply_text || assistantState.text || '').trim();
            assistantState.text = finalText;
            assistantState.textNode.nodeValue = finalText || '(no reply)';
            finishAssistantMessage(assistantState.el, {
              runtime: 'voice-ptt-stream',
              face_lobe_model: payload.foreground_model,
              grounding_source: payload.grounding_source,
              router: payload.router,
              dispatched_job: payload.dispatched_job,
              metrics: payload.metrics?.chat_metrics,  // upper row gets chat metrics
            });
            // Attach a second pill row with voice-specific metrics.
            const vm = payload.metrics || {};
            const voicePill = document.createElement('div');
            voicePill.className = 'meta';
            voicePill.style.color = '#94a3b8';
            const parts = [];
            parts.push(`🎙️ asr ${vm.asr_ms ?? '?'}ms`);
            if (vm.chat_ms != null) parts.push(`chat ${vm.chat_ms}ms`);
            if (vm.first_text_token_ms != null) parts.push(`first text ${vm.first_text_token_ms}ms`);
            if (vm.first_audio_chunk_ms != null) parts.push(`first audio ${vm.first_audio_chunk_ms}ms`);
            if (vm.audio_chunks != null) parts.push(`${vm.audio_chunks} chunks`);
            if (vm.audio_errors) parts.push(`${vm.audio_errors} errors`);
            if (vm.total_ms != null) parts.push(`total ${vm.total_ms}ms`);
            // Parallelism summary: how concurrent is HiveMind TTS actually
            // running our chunks? speedup_ratio >> 1 means real parallel.
            if (vm.tts_parallelism && vm.audio_chunks > 1) {
              const tp = vm.tts_parallelism;
              parts.push(`tts ×${tp.speedup_ratio} parallel`);
              if (tp.any_held_for_inorder) {
                parts.push(`held ${tp.max_held_for_inorder_ms}ms`);
              }
            }
            voicePill.textContent = parts.join(' · ');
            voicePill.title = JSON.stringify(vm, null, 2);
            scheduleOracleIdleAfterPlayback(finalText || 'Ready.', voicePill.textContent);
            assistantState.el.appendChild(voicePill);
          }
          setVoiceStatus(`Voice turn complete in ${payload.metrics?.total_ms ?? '?'}ms`, 'ok');
          break outer;
        } else if (eventName === 'error') {
          throw new Error(payload.error || 'voice stream error');
        }
      }
    }
  } catch (error) {
    // AbortError is the normal outcome when bargeIn() killed the
    // fetch. Don't show it as a red error — the new turn is already
    // running.
    if (error && (error.name === 'AbortError' || /aborted/i.test(String(error.message || '')))) {
      return;
    }
    const msg = String(error.message || error || '');
    setVoiceStatus(`Voice turn failed: ${msg}`, 'error');
    // Audible failover: a stalled / unreachable / timed-out Face model
    // should SPEAK the canned "trouble reaching the cluster" reflex
    // instead of just showing red text, so a slow model never leaves the
    // user staring at a frozen "streaming…" with no feedback.
    if (/stall|did not respond|timed out|timeout|unreachable|reaching the (language )?cluster/i.test(msg)) {
      playReflex('err_cluster_unreachable');
    }
    // When the failure mode is "ASR unhealthy / no endpoints", surface
    // a one-click Provision button right next to the error so the
    // operator doesn't have to dig through settings.
    if (/voice_input_ready=false|No endpoints configured|asr.*unhealthy/i.test(msg)) {
      const provisionBtn = document.createElement('button');
      provisionBtn.type = 'button';
      provisionBtn.className = 'secondary';
      provisionBtn.textContent = '⚡ Provision ASR via HiveMind';
      provisionBtn.style.cssText = 'margin-left:8px; font-size:11px;';
      provisionBtn.addEventListener('click', async () => {
        provisionBtn.disabled = true;
        provisionBtn.textContent = 'Requesting…';
        await triggerVoiceServiceProvision('ASR', provisionBtn);
      });
      voiceStatusLine.appendChild(provisionBtn);
    }
  } finally {
    // Release the controller reference so the next turn installs a fresh
    // one; otherwise a later bargeIn() might call .abort() on a controller
    // that's already finished, which is harmless but confusing in DevTools.
    if (activeVoiceStreamController === streamController) {
      activeVoiceStreamController = null;
    }
    if (thinkingBridgeTimer) {
      clearTimeout(thinkingBridgeTimer);
      thinkingBridgeTimer = null;
    }
    // Turn finished (done/error/abort) — make sure the ambience never
    // lingers, e.g. a text-only reply that emitted no audio_chunk.
    stopThinkingAmbient();
  }
}

// Mic press = barge-in + start recording. Pressing the mic while MS4
// is talking immediately stops the audio so the user can speak over it.
//
// When full-duplex is ON, the press-and-hold pipeline would create a
// SECOND parallel /voice/turn/stream call for the same audio (the VAD
// pipeline is already capturing). That duplication shipped to a user
// as two identical "🎤 Okay, so right now?" rows in the message
// stream. So in full-duplex mode the mic button is a no-op (the icon
// has already changed to 📡 to signal hands-free is active) — except
// for a courtesy barge-in so the user can interrupt MS4 by tapping
// even before they speak.
function micPressedDown() {
  if (vadState.enabled) {
    // Full-duplex is on. Don't open a second capture pipeline; just
    // give the user the barge-in they tapped for.
    bargeIn('mic tap (full-duplex on)', {
      halfContext: isHalfContextEnabled(),
      playAck: false,  // VAD will fire its own ack on speech onset
    });
    setVoiceStatus('Full-duplex on — just speak (mic button is hands-free)', null);
    setOracleStageState('listening', 'Full-duplex listening.', 'Hands-free VAD is already active.');
    return;
  }
  bargeIn('mic press');
  startRecording();
}

function micReleased() {
  if (vadState.enabled) return;  // hands-free mode owns the lifecycle
  if (recorder) stopRecordingAndSend();
}

// ----- Full-duplex voice (VAD barge-in) ------------------------------
//
// When the operator enables full-duplex in Settings, MS4 holds the mic
// open continuously, runs a Voice Activity Detector on it, and treats
// every speech onset / speech offset like a hands-free PTT cycle:
//
//   speech onset  -> bargeIn(reason='vad_speech_onset', halfContext=true, playAck=true)
//                    + start a new recording buffer
//   speech offset -> stop the recording buffer, encode WAV,
//                    submit via submitWavBlobAsVoiceTurn()
//
// The VAD is intentionally simple: AnalyserNode → time-domain RMS →
// smoothed → state machine. No CDN deps, no WASM. It's good enough
// for "ChatGPT mobile feel" in a quiet-ish room; aggressive noise
// suppression is delegated to the browser's `noiseSuppression: true`
// constraint on getUserMedia.

const FULL_DUPLEX_KEY = 'ms4_voice_full_duplex';
const VAD_ACK_KEY = 'ms4_voice_vad_ack';
const VAD_HALFCTX_KEY = 'ms4_voice_vad_halfctx';
const VAD_SPEECH_THRESHOLD_KEY = 'ms4_voice_vad_speech_threshold';
const VAD_MIN_SPEECH_MS_KEY = 'ms4_voice_vad_min_speech_ms';
const VAD_HANGOVER_MS_KEY = 'ms4_voice_vad_hangover_ms';

function updateHandsfreePrompt() {
  if (!oracleHandsfreePrompt) return;
  oracleHandsfreePrompt.hidden = localStorage.getItem(FULL_DUPLEX_KEY) !== null;
}

if (oracleStartHandsfree) {
  oracleStartHandsfree.addEventListener('click', async () => {
    const original = oracleStartHandsfree.textContent;
    oracleStartHandsfree.disabled = true;
    oracleStartHandsfree.textContent = 'Starting...';
    await enableFullDuplex();
    if (vadState.enabled) {
      localStorage.setItem(FULL_DUPLEX_KEY, 'true');
      if (settingsFullDuplexToggle) settingsFullDuplexToggle.checked = true;
    }
    updateHandsfreePrompt();
    oracleStartHandsfree.disabled = false;
    oracleStartHandsfree.textContent = original;
  });
}

if (oracleKeepPushToTalk) {
  oracleKeepPushToTalk.addEventListener('click', () => {
    localStorage.setItem(FULL_DUPLEX_KEY, 'false');
    updateHandsfreePrompt();
  });
}

function isFullDuplexEnabled() {
  return localStorage.getItem(FULL_DUPLEX_KEY) === 'true';
}
function isVadAckEnabled() {
  const v = localStorage.getItem(VAD_ACK_KEY);
  return v === null ? true : v === 'true';
}
function isHalfContextEnabled() {
  const v = localStorage.getItem(VAD_HALFCTX_KEY);
  return v === null ? true : v === 'true';
}
function vadSpeechThreshold() {
  return parseFloat(localStorage.getItem(VAD_SPEECH_THRESHOLD_KEY) || '0.025');
}
function vadMinSpeechMs() {
  return parseInt(localStorage.getItem(VAD_MIN_SPEECH_MS_KEY) || '160', 10);
}
function vadHangoverMs() {
  // End-of-turn silence. Raised 700 -> 1400ms (Jun 1 2026) so a natural
  // mid-thought pause no longer ends the turn, splits the utterance, and
  // truncates long speech to the last fragment. Tradeoff: the reply
  // starts ~0.7s after you stop talking. Tunable via the Settings slider.
  return parseInt(localStorage.getItem(VAD_HANGOVER_MS_KEY) || '1400', 10);
}
const VAD_ADAPTIVE_KEY = 'ms4_voice_vad_adaptive';
function isVadAdaptiveEnabled() {
  // Default ON.
  const v = localStorage.getItem(VAD_ADAPTIVE_KEY);
  return v === null ? true : v === 'true';
}
// Adaptive end-of-turn: shorten the wait ONLY after a clearly-complete,
// LONG utterance (you've made a full statement, not a mid-thought
// fragment), and never below a safe floor. Short utterances keep the
// full hangover so we never clip someone gathering their thoughts — the
// behavior the operator explicitly asked to preserve.
const VAD_ADAPTIVE_LONG_SPEECH_MS = 2600;  // "substantial utterance" gate
const VAD_ADAPTIVE_FLOOR_MS = 900;          // never end faster than this
function vadEffectiveHangoverMs() {
  const base = vadHangoverMs();
  if (!isVadAdaptiveEnabled()) return base;
  const speechMs = (vadState.lastSpeechSampleAt || 0) - (vadState.speechStartedAt || 0);
  if (speechMs >= VAD_ADAPTIVE_LONG_SPEECH_MS) {
    // Long, complete-sounding utterance -> respond sooner, but gently.
    return Math.max(VAD_ADAPTIVE_FLOOR_MS, Math.round(base * 0.65));
  }
  return base;  // short/mid-thought -> keep the full, generous pause
}
// How soon after an offset a new onset counts as a CONTINUATION of the
// same utterance (re-append) rather than a brand-new turn. Guards against
// the rare case where a pause briefly exceeds the hangover mid-sentence.
const VAD_CONTINUATION_WINDOW_MS = 1200;

const vadState = {
  enabled: false,
  // Audio plumbing kept alive across turns.
  mediaStream: null,
  audioContext: null,
  audioInput: null,
  analyser: null,
  // Recording side (parallel to the analyser).
  recorder: null,
  recordedChunks: [],
  sourceSampleRate: 0,
  // VAD state machine.
  phase: 'silence',         // 'silence' | 'maybe_speech' | 'speech' | 'maybe_silence'
  smoothedRms: 0,
  lastTransitionAt: 0,
  speechStartedAt: 0,
  lastSpeechSampleAt: 0,
  // Sampling loop.
  pollTimer: null,
};

function vadStateLabel() {
  if (!vadState.enabled) return 'disabled';
  switch (vadState.phase) {
    case 'silence':       return 'listening';
    case 'maybe_speech':  return 'maybe speaking…';
    case 'speech':        return '🎤 speaking';
    case 'maybe_silence': return 'trailing off…';
    default:              return vadState.phase;
  }
}

function setVadStateLabel() {
  const el = document.getElementById('settingsVadState');
  if (el) el.textContent = vadStateLabel();
}

function setMicMeter(rms) {
  setOracleInputLevel(rms);
  const bar = document.getElementById('settingsVadMicMeterBar');
  const tick = document.getElementById('settingsVadMicMeterThreshold');
  if (bar) {
    // Map 0..0.20 linearly to 0..100%. The interesting range for
    // speech is ~0.01-0.10 RMS so the meter saturates above that.
    const pct = Math.max(0, Math.min(100, Math.round((rms / 0.20) * 100)));
    bar.style.width = pct + '%';
  }
  if (tick) {
    const pct = Math.max(0, Math.min(100, Math.round((vadSpeechThreshold() / 0.20) * 100)));
    tick.style.left = pct + '%';
  }
}

async function enableFullDuplex() {
  if (vadState.enabled) return;
  // Grant mic permission once and hold the stream open across turns.
  try {
    vadState.mediaStream = await acquireMicStream();
  } catch (error) {
    setVoiceStatus(`Full-duplex: ${micErrorMessage(error)}`, 'error');
    localStorage.setItem(FULL_DUPLEX_KEY, 'false');
    const toggle = document.getElementById('settingsFullDuplex');
    if (toggle) toggle.checked = false;
    return;
  }
  try {
    vadState.audioContext = new (window.AudioContext || window.webkitAudioContext)();
    if (vadState.audioContext.state === 'suspended') await vadState.audioContext.resume();
    vadState.sourceSampleRate = vadState.audioContext.sampleRate;
    vadState.audioInput = vadState.audioContext.createMediaStreamSource(vadState.mediaStream);

    // VAD branch: time-domain analyser sampled at ~33 Hz.
    vadState.analyser = vadState.audioContext.createAnalyser();
    vadState.analyser.fftSize = 1024;
    vadState.analyser.smoothingTimeConstant = 0;  // we do our own EMA
    vadState.audioInput.connect(vadState.analyser);

    // Capture branch: ScriptProcessor → silent gain → destination.
    // Same shape as the PTT path. Buffers are pushed into a *separate*
    // accumulator from PTT's `recordedChunks` so the two paths can't
    // step on each other.
    vadState.recorder = vadState.audioContext.createScriptProcessor(4096, 1, 1);
    vadState.recordedChunks = [];
    vadState.recorder.onaudioprocess = (event) => {
      // Always copy and buffer — but only commit to the "this turn"
      // accumulator once the VAD says we're in speech. We use a
      // small pre-roll buffer so the first 150-300 ms of the utterance
      // (which the VAD needs to confirm) isn't lost.
      const samples = event.inputBuffer.getChannelData(0);
      vadPushAudio(samples);
    };
    vadState.audioInput.connect(vadState.recorder);
    const silent = vadState.audioContext.createGain();
    silent.gain.value = 0;
    vadState.recorder.connect(silent);
    silent.connect(vadState.audioContext.destination);
  } catch (error) {
    setVoiceStatus(`Full-duplex AudioContext init failed: ${error.message || error}`, 'error');
    localStorage.setItem(FULL_DUPLEX_KEY, 'false');
    disableFullDuplex({silent: true});
    updateHandsfreePrompt();
    return;
  }

  vadState.enabled = true;
  vadState.phase = 'silence';
  vadState.smoothedRms = 0;
  vadState.lastTransitionAt = Date.now();
  vadState.lastSpeechSampleAt = 0;
  vadState.recordedChunks = [];
  vadPreRoll = [];
  vadState.pollTimer = setInterval(vadTick, 30);
  localStorage.setItem(FULL_DUPLEX_KEY, 'true');
  updateHandsfreePrompt();
  setVoiceStatus('Full-duplex on — listening continuously', 'ok');
  setOracleStageState('listening', 'Full-duplex listening.', 'VAD is armed for hands-free turns.');
  setVadStateLabel();
  micButton.textContent = '📡';
  micButton.title = 'Full-duplex listening (VAD). Disable in Settings to return to push-to-talk.';
}

function disableFullDuplex(options) {
  const opts = options || {};
  if (vadState.pollTimer) {
    clearInterval(vadState.pollTimer);
    vadState.pollTimer = null;
  }
  if (vadState.recorder) try { vadState.recorder.disconnect(); } catch (e) {}
  if (vadState.audioInput) try { vadState.audioInput.disconnect(); } catch (e) {}
  if (vadState.mediaStream) vadState.mediaStream.getTracks().forEach(t => { try { t.stop(); } catch (e) {} });
  if (vadState.audioContext && vadState.audioContext.state !== 'closed') {
    try { vadState.audioContext.close(); } catch (e) {}
  }
  vadState.enabled = false;
  vadState.mediaStream = null;
  vadState.audioContext = null;
  vadState.audioInput = null;
  vadState.analyser = null;
  vadState.recorder = null;
  vadState.recordedChunks = [];
  vadState.phase = 'silence';
  vadPreRoll = [];
  setMicMeter(0);
  setVadStateLabel();
  micButton.textContent = '🎤';
  micButton.title = '';
  if (!opts.silent) setVoiceStatus('Full-duplex off', null);
  if (!opts.silent) setOracleStageState('idle', 'Ready.', 'Push-to-talk mode is active.');
}

// Rolling pre-roll buffer of audio frames captured BEFORE the VAD
// confirms speech. When onset fires, we prepend the pre-roll to the
// recorded utterance so the first ~400 ms of the user's voice (which the
// VAD took to identify) isn't clipped. Raised 8 -> 12 frames (Jun 1 2026)
// to give more head-room on quiet/ramping speech onsets.
const VAD_PREROLL_MAX_FRAMES = 12;  // ~1.0s at 4096-sample frames @ 48 kHz
let vadPreRoll = [];

function vadPushAudio(samples) {
  const copy = new Float32Array(samples);
  if (vadState.phase === 'speech' || vadState.phase === 'maybe_silence') {
    // We're accumulating an utterance — every frame matters.
    vadState.recordedChunks.push(copy);
    return;
  }
  // Otherwise keep a short rolling pre-roll so we don't clip the
  // first 200 ms of speech when the VAD finally fires.
  vadPreRoll.push(copy);
  while (vadPreRoll.length > VAD_PREROLL_MAX_FRAMES) vadPreRoll.shift();
}

function vadComputeRms() {
  if (!vadState.analyser) return 0;
  const buf = new Float32Array(vadState.analyser.fftSize);
  // getFloatTimeDomainData was added in Chrome 52 / FF 30 — widely
  // available now. If it's missing, fall back to byte-domain math.
  if (vadState.analyser.getFloatTimeDomainData) {
    vadState.analyser.getFloatTimeDomainData(buf);
    let sum = 0;
    for (let i = 0; i < buf.length; i++) sum += buf[i] * buf[i];
    return Math.sqrt(sum / buf.length);
  }
  const bytes = new Uint8Array(vadState.analyser.fftSize);
  vadState.analyser.getByteTimeDomainData(bytes);
  let sum = 0;
  for (let i = 0; i < bytes.length; i++) {
    const v = (bytes[i] - 128) / 128;
    sum += v * v;
  }
  return Math.sqrt(sum / bytes.length);
}

// Smoothing alpha for the RMS EMA. Smaller = laggier but less jittery.
const VAD_EMA_ALPHA = 0.35;
const VAD_HYSTERESIS_RATIO = 0.6;  // silence threshold = 0.6 × speech threshold

function vadTick() {
  if (!vadState.enabled || !vadState.analyser) return;
  const rms = vadComputeRms();
  vadState.smoothedRms = (1 - VAD_EMA_ALPHA) * vadState.smoothedRms + VAD_EMA_ALPHA * rms;
  setMicMeter(vadState.smoothedRms);

  const speechT = vadSpeechThreshold();
  const silenceT = speechT * VAD_HYSTERESIS_RATIO;
  const now = Date.now();

  switch (vadState.phase) {
    case 'silence':
      if (vadState.smoothedRms >= speechT) {
        vadState.phase = 'maybe_speech';
        vadState.lastTransitionAt = now;
        setVadStateLabel();
      }
      break;
    case 'maybe_speech':
      if (vadState.smoothedRms < silenceT) {
        // False alarm (a click, key press, breath) — back to silence.
        vadState.phase = 'silence';
        vadState.lastTransitionAt = now;
        setVadStateLabel();
        break;
      }
      if (now - vadState.lastTransitionAt >= vadMinSpeechMs()) {
        // Confirmed speech.
        vadState.phase = 'speech';
        vadState.lastTransitionAt = now;
        vadState.speechStartedAt = now;
        vadState.lastSpeechSampleAt = now;
        setVadStateLabel();
        onVadSpeechOnset();
      }
      break;
    case 'speech':
      if (vadState.smoothedRms >= silenceT) {
        vadState.lastSpeechSampleAt = now;
      } else {
        vadState.phase = 'maybe_silence';
        vadState.lastTransitionAt = now;
        setVadStateLabel();
      }
      break;
    case 'maybe_silence':
      if (vadState.smoothedRms >= speechT) {
        // User started speaking again before we crossed hangover —
        // still the same utterance.
        vadState.phase = 'speech';
        vadState.lastSpeechSampleAt = now;
        setVadStateLabel();
        break;
      }
      if (now - vadState.lastTransitionAt >= vadEffectiveHangoverMs()) {
        // Confirmed silence → end of utterance. The hangover is adaptive:
        // shorter after a long, clearly-complete utterance; full-length
        // after a short one so a mid-thought pause is never clipped.
        vadState.phase = 'silence';
        vadState.lastTransitionAt = now;
        setVadStateLabel();
        onVadSpeechOffset();
      }
      break;
  }
}

function onVadSpeechOnset() {
  // The user just started speaking. The moment we confirm onset:
  //
  // 1. Half-context barge-in: MS4's currently-playing word tails off
  //    (~250 ms) instead of cutting mid-syllable; queued chunks and the
  //    in-flight SSE fetch are cancelled. EXCEPT on a continuation (a
  //    brief pause then resume within VAD_CONTINUATION_WINDOW_MS) where
  //    we keep the prior stream so its transcript isn't lost.
  // 2. A soft, low-volume "heard you" tick earcon (NOT a spoken phrase)
  //    plays in ~5 ms so we don't talk over the user. Spoken
  //    acknowledgments now happen AFTER the user finishes (server-driven
  //    `reflex` SSE event).
  // 3. The recording buffer prepends the rolling pre-roll so we don't
  //    clip the first ~400 ms of the user's voice.
  const isContinuation = (Date.now() - (vadState.lastOffsetAt || 0)) < VAD_CONTINUATION_WINDOW_MS;
  bargeIn('vad_speech_onset', {
    halfContext: isHalfContextEnabled(),
    playAck: false,             // onset ack is now the soft tick below, not a spoken reflex
    keepStream: isContinuation, // don't drop the prior transcript on a quick resume
  });
  if (isVadAckEnabled()) {
    playOnsetTick();
  }
  vadState.recordedChunks = vadPreRoll.slice();
  vadPreRoll = [];
}

async function onVadSpeechOffset() {
  // Speech offset = end of utterance after hangover. Build the WAV
  // and hand it to the existing /voice/turn/stream pipeline. No mic
  // teardown — the stream stays open for the next utterance.
  vadState.lastOffsetAt = Date.now();  // continuation window anchor
  const chunks = vadState.recordedChunks.slice();
  vadState.recordedChunks = [];
  if (chunks.length === 0) return;
  try {
    const float32 = concatenateFloat32(chunks);
    const downsampled = downsampleTo(float32, vadState.sourceSampleRate, TARGET_SAMPLE_RATE);
    const wavBlob = encodeWavBlob(downsampled, TARGET_SAMPLE_RATE);
    const durationSec = (Date.now() - vadState.speechStartedAt) / 1000;
    await submitWavBlobAsVoiceTurn(wavBlob, {durationSec, sourceLabel: 'vad'});
  } catch (err) {
    console.warn('VAD utterance submit failed:', err);
    setVoiceStatus(`VAD utterance submit failed: ${err.message || err}`, 'error');
  }
}

// ----- Settings dialog wiring for full-duplex ------------------------

const settingsFullDuplexToggle = document.getElementById('settingsFullDuplex');
const settingsVadAckToggle = document.getElementById('settingsVadAckOnOnset');
const settingsHalfContextToggle = document.getElementById('settingsHalfContext');
const settingsVadSpeechThresholdSlider = document.getElementById('settingsVadSpeechThreshold');
const settingsVadSpeechThresholdLabel = document.getElementById('settingsVadSpeechThresholdLabel');
const settingsVadMinSpeechMsSlider = document.getElementById('settingsVadMinSpeechMs');
const settingsVadMinSpeechMsLabel = document.getElementById('settingsVadMinSpeechMsLabel');
const settingsVadHangoverMsSlider = document.getElementById('settingsVadHangoverMs');
const settingsVadHangoverMsLabel = document.getElementById('settingsVadHangoverMsLabel');

if (settingsFullDuplexToggle) {
  settingsFullDuplexToggle.checked = isFullDuplexEnabled();
  settingsFullDuplexToggle.addEventListener('change', async () => {
    localStorage.setItem(FULL_DUPLEX_KEY, settingsFullDuplexToggle.checked ? 'true' : 'false');
    if (settingsFullDuplexToggle.checked) await enableFullDuplex();
    else disableFullDuplex();
  });
}
if (settingsVadAckToggle) {
  settingsVadAckToggle.checked = isVadAckEnabled();
  settingsVadAckToggle.addEventListener('change', () => {
    localStorage.setItem(VAD_ACK_KEY, settingsVadAckToggle.checked ? 'true' : 'false');
  });
}
if (settingsHalfContextToggle) {
  settingsHalfContextToggle.checked = isHalfContextEnabled();
  settingsHalfContextToggle.addEventListener('change', () => {
    localStorage.setItem(VAD_HALFCTX_KEY, settingsHalfContextToggle.checked ? 'true' : 'false');
  });
}
const settingsVadAdaptiveToggle = document.getElementById('settingsVadAdaptive');
if (settingsVadAdaptiveToggle) {
  settingsVadAdaptiveToggle.checked = isVadAdaptiveEnabled();
  settingsVadAdaptiveToggle.addEventListener('change', () => {
    localStorage.setItem(VAD_ADAPTIVE_KEY, settingsVadAdaptiveToggle.checked ? 'true' : 'false');
  });
}
const settingsThinkingAmbienceToggle = document.getElementById('settingsThinkingAmbience');
if (settingsThinkingAmbienceToggle) {
  settingsThinkingAmbienceToggle.checked = isThinkingAmbienceEnabled();
  settingsThinkingAmbienceToggle.addEventListener('change', () => {
    localStorage.setItem(THINKING_AMBIENCE_KEY, settingsThinkingAmbienceToggle.checked ? 'true' : 'false');
    if (!settingsThinkingAmbienceToggle.checked) stopThinkingAmbient();
  });
}
const settingsSpeakCompletionsToggle = document.getElementById('settingsSpeakCompletions');
if (settingsSpeakCompletionsToggle) {
  settingsSpeakCompletionsToggle.checked = isSpeakCompletionsEnabled();
  settingsSpeakCompletionsToggle.addEventListener('change', () => {
    localStorage.setItem(SPEAK_COMPLETIONS_KEY, settingsSpeakCompletionsToggle.checked ? 'true' : 'false');
  });
}
function bindVadSlider(slider, label, storageKey, fmt) {
  if (!slider || !label) return;
  const stored = localStorage.getItem(storageKey);
  if (stored !== null) slider.value = stored;
  label.textContent = fmt(slider.value);
  slider.addEventListener('input', () => {
    label.textContent = fmt(slider.value);
    localStorage.setItem(storageKey, slider.value);
    setMicMeter(vadState.smoothedRms || 0);  // redraw threshold tick
  });
}
bindVadSlider(settingsVadSpeechThresholdSlider, settingsVadSpeechThresholdLabel,
              VAD_SPEECH_THRESHOLD_KEY, v => parseFloat(v).toFixed(3));
bindVadSlider(settingsVadMinSpeechMsSlider, settingsVadMinSpeechMsLabel,
              VAD_MIN_SPEECH_MS_KEY, v => `${v} ms`);
bindVadSlider(settingsVadHangoverMsSlider, settingsVadHangoverMsLabel,
              VAD_HANGOVER_MS_KEY, v => `${v} ms`);

// Auto-arm on page load if the user previously enabled full-duplex.
// We defer until after the page settles so the initial render is
// snappy and the user sees the UI before the permission prompt.
if (isFullDuplexEnabled()) {
  setTimeout(() => { enableFullDuplex().catch(() => {}); }, 800);
}
updateHandsfreePrompt();

micButton.addEventListener('mousedown', micPressedDown);
micButton.addEventListener('touchstart', evt => { evt.preventDefault(); micPressedDown(); }, {passive: false});
micButton.addEventListener('mouseup', micReleased);
micButton.addEventListener('mouseleave', micReleased);
micButton.addEventListener('touchend', evt => { evt.preventDefault(); micReleased(); }, {passive: false});

Promise.allSettled([refreshHealth(), refreshVoice(), loadModels(), refreshHermesVersion(), refreshDoubleAgent()]);
setInterval(refreshHermesVersion, 60_000);
setInterval(refreshDoubleAgent, 30_000);
if (sessionId) sessionEl.textContent = sessionId;
</script>
