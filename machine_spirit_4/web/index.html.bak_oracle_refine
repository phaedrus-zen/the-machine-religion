// ----- Proactive Depth Lobe completion delivery -----------------------
// "A system keeps tabs": when a deep job we were watching transitions
// from in-flight -> terminal, announce it inline in the transcript with
// its result. We only announce jobs we OBSERVED running this page
// session (daSeenInFlight), so the historical backlog never spams. The
// localStorage set is belt-and-suspenders against re-announcing across
// reloads.
const DA_TERMINAL_STATES = new Set(['completed', 'failed', 'canceled']);
let daSeenInFlight = new Set();
let daAnnounced = new Set();
let daAnnouncedSession = null;

function daAnnouncedKey(sid) { return `ms4_da_announced_${sid}`; }

function daLoadAnnounced(sid) {
  if (daAnnouncedSession === sid) return;
  try {
    const raw = localStorage.getItem(daAnnouncedKey(sid));
    daAnnounced = new Set(raw ? JSON.parse(raw) : []);
  } catch (e) { daAnnounced = new Set(); }
  daSeenInFlight = new Set();  // in-flight observations are per page-session
  daAnnouncedSession = sid;
}

function daPersistAnnounced(sid) {
  try { localStorage.setItem(daAnnouncedKey(sid), JSON.stringify([...daAnnounced])); } catch (e) {}
}

// ---- Proactive SPOKEN delivery of deep-job completions -------------------
// In a voice conversation the visual "Deep job done" bubble isn't enough —
// the operator is hands-free and not staring at the screen, so the agent
// has to speak up on its own. These helpers synthesize a short, natural
// announcement and play it WHEN it won't talk over the user.
const SPEAK_COMPLETIONS_KEY = 'ms4_da_speak_completions';
function isSpeakCompletionsEnabled() {
  // Default ON. Only the explicit string 'false' disables it.
  return localStorage.getItem(SPEAK_COMPLETIONS_KEY) !== 'false';
}

const DA_DONE_OPENERS = ['Heads up \u2014', 'Quick update \u2014', 'Good news \u2014', 'Okay, that finished \u2014'];

function _firstSentence(s, max) {
  s = (s || '').replace(/\s+/g, ' ').trim();
  if (!s) return '';
  const m = s.match(/^.*?[.!?](\s|$)/);
  let out = m ? m[0].trim() : s;
  if (out.length > max) out = out.slice(0, max - 1).trim() + '\u2026';
  return out;
}

function buildCompletionSpeech(job) {
  const opener = DA_DONE_OPENERS[Math.floor(Math.random() * DA_DONE_OPENERS.length)];
  if (job.state === 'failed') {
    const why = _firstSentence(job.last_safe_user_status, 120);
    return `${opener} that background job didn't pan out.${why ? ' ' + why : ''}`;
  }
  const gist = _firstSentence(job.last_safe_user_status, 140);
  return gist
    ? `${opener} that's ready. Here's the gist: ${gist} Want the full details?`
    : `${opener} the background work you asked about is ready. Want the details?`;
}

// A soft two-tone "something's ready" earcon so even a missed word still
// registers as a notification. Web Audio, ~250ms, low volume.
function playNotifyChime() {
  try {
    const ctx = getPlaybackCtx();
    const t = Math.max(nextChunkStartTime, ctx.currentTime) + 0.02;
    [[660, 0], [880, 0.12]].forEach(([freq, off]) => {
      const o = ctx.createOscillator();
      const g = ctx.createGain();
      o.type = 'sine';
      o.frequency.value = freq;
      g.gain.setValueAtTime(0.0001, t + off);
      g.gain.exponentialRampToValueAtTime(0.16, t + off + 0.02);
      g.gain.exponentialRampToValueAtTime(0.0001, t + off + 0.16);
      o.connect(g); g.connect(ctx.destination);
      o.start(t + off); o.stop(t + off + 0.18);
    });
  } catch (e) { /* best-effort cue */ }
}

async function speakAnnouncement(text) {
  // Synthesize via the same REST TTS path the voice turns use, then play
  // through the shared Web Audio queue so barge-in can stop it if the
  // user starts talking.
  try {
    const r = await fetch('/voice/synthesize', {
      method: 'POST',
      headers: {'Content-Type': 'application/json'},
      body: JSON.stringify({text}),
    });
    if (!r.ok) throw new Error('synthesize HTTP ' + r.status);
    const ctx = getPlaybackCtx();
    const buf = await ctx.decodeAudioData(await r.arrayBuffer());
    const startAt = Math.max(nextChunkStartTime, ctx.currentTime) + 0.02;
    const src = ctx.createBufferSource();
    src.buffer = buf;
    src.connect(oraclePlaybackNodeForSource(ctx));
    src.start(startAt);
    nextChunkStartTime = startAt + buf.duration;
    const entry = {source: src, startAt, endAt: startAt + buf.duration};
    activeAudioSources.push(entry);
    markOraclePlaybackActive();
    src.onended = () => { activeAudioSources = activeAudioSources.filter(e => (e.source || e) !== src); };
    return true;
  } catch (e) {
    console.warn('speakAnnouncement failed:', e);
    return false;
  }
}

function _isUserSpeakingNow() {
  return vadState.enabled && (vadState.phase === 'speech' || vadState.phase === 'maybe_speech');
}
function _isVoiceBusy() {
  // Reply stream in flight, or user mid-utterance, or audio still playing.
  if (activeVoiceStreamController) return true;
  if (_isUserSpeakingNow()) return true;
  if (playbackCtx) {
    const now = playbackCtx.currentTime;
    if (activeAudioSources.some(e => (e.endAt || 0) > now + 0.05)) return true;
  }
  return false;
}

let daSpeakRetryTimer = null;
function speakCompletionWhenQuiet(text, attempt) {
  attempt = attempt || 0;
  if (attempt > 16) return;  // ~20s budget; the visual bubble still stands
  if (_isVoiceBusy()) {
    if (daSpeakRetryTimer) clearTimeout(daSpeakRetryTimer);
    daSpeakRetryTimer = setTimeout(() => speakCompletionWhenQuiet(text, attempt + 1), 1300);
    return;
  }
  if (attempt === 0) {
    // First clean shot: chime, then speak after it rings out.
    playNotifyChime();
    setTimeout(() => { if (!_isUserSpeakingNow()) speakAnnouncement(text); }, 380);
  } else {
    speakAnnouncement(text);
  }
}

function announceDoubleAgentCompletion(job) {
  const failed = job.state === 'failed';
  const el = document.createElement('div');
  el.className = 'msg system';
  el.style.cssText = 'border-left:3px solid ' + (failed ? '#ef4444' : '#22c55e') + '; padding-left:10px;';
  const head = document.createElement('div');
  head.style.cssText = 'font-weight:600; margin-bottom:2px;';
  head.textContent = (failed ? '\u26A0 Deep job failed \u2014 ' : '\u2705 Deep job done \u2014 ') + (job.user_visible_goal || '');
  const summary = document.createElement('div');
  summary.style.cssText = 'font-size:13px; margin-bottom:3px;';
  summary.textContent = job.last_safe_user_status || '(no summary)';
  const sub = document.createElement('div');
  sub.className = 'muted';
  sub.style.cssText = 'font-size:11px;';
  sub.textContent = 'from your earlier question \u00B7 ' + job.job_id;
  el.append(head, summary, sub);

  const btn = document.createElement('button');
  btn.className = 'secondary';
  btn.type = 'button';
  btn.textContent = 'Show details';
  btn.style.cssText = 'margin-top:6px; font-size:12px;';
  const detail = document.createElement('pre');
  detail.style.cssText = 'display:none; white-space:pre-wrap; margin-top:6px; max-height:320px; overflow:auto; font-size:12px; background:#0e0f17; border:1px solid #2d2d44; border-radius:6px; padding:8px;';
  btn.addEventListener('click', async () => {
    if (detail.style.display === 'none') {
      if (!detail.dataset.loaded) {
        btn.disabled = true;
        try {
          const r = await fetch(`/api/v1/double-agent/jobs/${encodeURIComponent(job.job_id)}`);
          const data = r.ok ? await r.json() : {};
          detail.textContent = (data.result && data.result.text) || data.last_safe_user_status || '(no result text)';
          detail.dataset.loaded = '1';
        } catch (e) {
          detail.textContent = `failed to load result: ${e.message || e}`;
        } finally { btn.disabled = false; }
      }
      detail.style.display = 'block';
      btn.textContent = 'Hide details';
    } else {
      detail.style.display = 'none';
      btn.textContent = 'Show details';
    }
  });
  el.append(btn, detail);
  messages.appendChild(el);
  messages.scrollTop = messages.scrollHeight;

  // Proactively SPEAK it when we're in a voice conversation — the whole
  // point of the complaint: don't make the operator ask "is it done?".
  // Gated behind voice mode (text users see the bubble) and a toggle.
  if (voiceModeActive && isSpeakCompletionsEnabled()) {
    speakCompletionWhenQuiet(buildCompletionSpeech(job), 0);
  }
}

function daAnnounceTerminalJobs(jobs) {
  daLoadAnnounced(sessionId);
  for (const job of jobs) {
    if (job.state === 'queued' || job.state === 'running') {
      daSeenInFlight.add(job.job_id);
      continue;
    }
    if (!DA_TERMINAL_STATES.has(job.state)) continue;
    if (!daSeenInFlight.has(job.job_id)) continue;  // never watched it run -> backlog, skip
    if (daAnnounced.has(job.job_id)) continue;
    if (job.state !== 'canceled') announceDoubleAgentCompletion(job);  // canceled = no bubble
    daAnnounced.add(job.job_id);
    daPersistAnnounced(sessionId);
  }
}

async function refreshDoubleAgent() {
  if (!sessionId) {
    daPanel.style.display = 'none';
    setOracleLobeState([]);
    return;
  }
  const q = new URLSearchParams({conversation_id: sessionId, limit: '20'}).toString();
  try {
    const [jobsResp, revResp] = await Promise.all([
      fetch(`/api/v1/double-agent/jobs?${q}`),
      fetch(`/api/v1/double-agent/conversations/${encodeURIComponent(sessionId)}/revisions`),
    ]);
    const jobsData = jobsResp.ok ? await jobsResp.json() : {jobs: []};
    const revData = revResp.ok ? await revResp.json() : {revision_id: null};
    const jobs = jobsData.jobs || [];
    renderDoubleAgentJobs(jobs, revData.revision_id);
    setOracleLobeState(jobs);
    daAnnounceTerminalJobs(jobs);  // proactive completion delivery
    const anyInFlight = jobs.some(j => j.state === 'queued' || j.state === 'running');
    if (anyInFlight && !daPollHandle) {
      daPollHandle = setInterval(refreshDoubleAgent, 3000);
    } else if (!anyInFlight && daPollHandle) {
      clearInterval(daPollHandle);
      daPollHandle = null;
    }
  } catch (error) {
    daPanel.style.display = 'none';
  }
}

async function cancelDoubleAgentJob(jobId) {
  try {
    await fetch(`/api/v1/double-agent/jobs/${encodeURIComponent(jobId)}/cancel`, {method: 'POST'});
  } catch (error) {
    console.warn('cancel failed', error);
  } finally {
