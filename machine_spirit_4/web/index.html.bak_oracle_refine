async function refreshHivemindTraining() {
  if (!settingsHivemindTraining) return;
  settingsHivemindTraining.textContent = 'Loading…';
  try {
    const r = await fetch('/hivemind/training', {cache: 'no-store'});
    if (!r.ok) throw new Error(`HTTP ${r.status}`);
    const data = await r.json();
    const lines = [];
    const backends = data.backends || [];
    lines.push(`backends   = ${backends.length}`);
    for (const b of backends.slice(0, 6)) {
      const name = b.name || b.id || '?';
      const supports = (b.supports || []).join(',');
      lines.push(`  ${name}  ${supports ? '(' + supports + ')' : ''}`);
    }
    const status = data.status;
    if (status && typeof status === 'object') {
      const jobs = status.jobs || status.active_jobs || [];
      lines.push(`active jobs = ${Array.isArray(jobs) ? jobs.length : 'n/a'}`);
      if (Array.isArray(jobs)) {
        for (const j of jobs.slice(0, 4)) {
          lines.push(`  ${j.id || j.job_id || '?'}  state=${j.state || '?'}  model=${j.model || '?'}`);
        }
      }
    }
    if (data.errors && data.errors.length) lines.push(`errors      = ${data.errors.join('; ')}`);
    settingsHivemindTraining.innerHTML = '';
    const pre = document.createElement('pre');
    pre.style.cssText = 'margin:0; white-space:pre-wrap; background:#0e0f17; padding:6px; border-radius:6px; border:1px solid #2d2d44; font-size:11px;';
