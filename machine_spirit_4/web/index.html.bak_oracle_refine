<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>MS4 Fusion Runtime</title>
  <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' rx='14' fill='%23090912'/%3E%3Cpath d='M32 8 51 20v24L32 56 13 44V20Z' fill='none' stroke='%23a855ff' stroke-width='4'/%3E%3Ccircle cx='24' cy='28' r='5' fill='%238cf000'/%3E%3Ccircle cx='40' cy='28' r='5' fill='%238cf000'/%3E%3Cpath d='M22 42h20' stroke='%2332d4ff' stroke-width='4' stroke-linecap='round'/%3E%3C/svg%3E">
  <style>
    body { margin: 0; font-family: Segoe UI, system-ui, sans-serif; background: #090912; color: #e6e6f0; }
    main { max-width: 1100px; margin: 0 auto; padding: 18px; display: grid; gap: 12px; }
    main.oracle-front-door { max-width: min(1280px, calc(100vw - 28px)); }
    main:not(.developer-view) .dev-only { display: none !important; }
    header, section { background: #121221; border: 1px solid #2d2d44; border-radius: 12px; padding: 14px; }
    header { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
    h1 { font-size: 18px; margin: 0; }
    .muted { color: #8f8fa8; font-size: 12px; }
    #messages { min-height: 420px; max-height: 60vh; overflow: auto; display: flex; flex-direction: column; gap: 10px; }
    .msg { padding: 10px 12px; border-radius: 10px; white-space: pre-wrap; line-height: 1.45; }
    .user { align-self: flex-end; background: #5c48d3; }
    .assistant { align-self: flex-start; background: #1d1d2d; border: 1px solid #33334a; }
    .meta { margin-top: 6px; color: #9999b4; font-size: 11px; }
    form { display: flex; gap: 8px; align-items: center; }
    input, select, button { box-sizing: border-box; background: #0c0c16; color: #e6e6f0; border: 1px solid #33334a; border-radius: 8px; padding: 10px; }
    input { flex: 1; }
    button { background: #6f50ff; cursor: pointer; }
    button:disabled { opacity: .5; cursor: not-allowed; }
    label.toggle { display: flex; align-items: center; gap: 6px; color: #b8b8d0; font-size: 12px; white-space: nowrap; }
    label.toggle input { flex: 0; }
    .grid { display: grid; grid-template-columns: 1fr 1fr 1fr 1fr; gap: 8px; }
    .front-door-control-row {
      display: flex;
      justify-content: center;
      gap: 8px;
      flex-wrap: wrap;
      background: transparent;
      border: 0;
      padding: 0;
    }
    .front-door-control-row button[aria-pressed="true"] {
      border-color: rgba(140, 240, 0, 0.64);
      box-shadow: 0 0 0 1px rgba(140, 240, 0, 0.20);
    }
    #chatForm { display: grid; grid-template-columns: minmax(0, 1fr) 48px auto; gap: 8px; align-items: center; }
    #messageInput { min-width: 0; width: 100%; justify-self: stretch; }
    #micButton { min-width: 48px; }
    @media (max-width: 800px) {
      .grid { grid-template-columns: 1fr; }
      #chatForm { grid-template-columns: 56px minmax(0, 1fr); align-items: stretch; }
      #messageInput { grid-column: 1 / -1; }
      #sendButton { min-width: 96px; }
    }
    .banner { display: none; padding: 12px 14px; border-radius: 10px; border: 1px solid rgba(245, 158, 11, 0.5); background: rgba(245, 158, 11, 0.10); color: #f5e7c2; }
    .banner.visible { display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap; }
    .banner .warn { font-size: 18px; line-height: 1; }
    .banner .text { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
    .banner .text strong { font-weight: 600; }
    .banner .text small { color: #c0a87b; font-size: 11px; }
    .banner.success { border-color: rgba(34, 197, 94, 0.5); background: rgba(34, 197, 94, 0.10); color: #c8f3d2; }
    .banner.error { border-color: rgba(239, 68, 68, 0.6); background: rgba(239, 68, 68, 0.10); color: #f4c2c2; }
    .banner button { background: #6f50ff; }
    .banner button.secondary { background: transparent; border: 1px solid currentColor; color: inherit; }
    .banner .spinner { width: 12px; height: 12px; border: 2px solid currentColor; border-top-color: transparent; border-radius: 50%; animation: spin 0.8s linear infinite; display: inline-block; vertical-align: middle; margin-right: 6px; }
    @keyframes spin { to { transform: rotate(360deg); } }
    .oracle-stage {
      --mirror-a-rgb: 168, 85, 255;
      --mirror-b-rgb: 140, 240, 0;
      --mirror-c-rgb: 50, 212, 255;
      --audio-level: 0.12;
      --audio-voice: 0.08;
      --audio-air: 0.10;
      --cell-audio: 0.20;
      --link-audio: 0.16;
      position: relative;
      isolation: isolate;
      display: grid;
      grid-template-columns: 1fr;
      justify-items: center;
      gap: 14px;
      min-height: clamp(520px, calc(100vh - 132px), 720px);
      padding: clamp(18px, 3vw, 32px);
      overflow: hidden;
      text-align: center;
      background:
        radial-gradient(62% 58% at 50% 38%, rgba(var(--mirror-a-rgb), 0.22), transparent 70%),
        radial-gradient(42% 46% at 70% 30%, rgba(var(--mirror-c-rgb), 0.11), transparent 72%),
        radial-gradient(48% 42% at 32% 74%, rgba(var(--mirror-b-rgb), 0.075), transparent 76%),
        linear-gradient(180deg, rgba(8, 8, 19, 0.98), rgba(4, 6, 10, 0.98));
      border-color: rgba(148, 163, 184, 0.24);
    }
    .oracle-stage::before,
    .oracle-stage::after {
      content: "";
      position: absolute;
      inset: 0;
      z-index: 0;
      pointer-events: none;
    }
    .oracle-stage::before {
      background:
        linear-gradient(rgba(245, 242, 255, 0.032) 1px, transparent 1px),
        linear-gradient(90deg, rgba(245, 242, 255, 0.026) 1px, transparent 1px),
        conic-gradient(from 230deg at 50% 46%, rgba(var(--mirror-a-rgb), 0), rgba(var(--mirror-a-rgb), 0.16), rgba(var(--mirror-b-rgb), 0.10), rgba(var(--mirror-c-rgb), 0.10), rgba(var(--mirror-a-rgb), 0));
      background-size: 46px 46px, 46px 46px, 100% 100%;
      mask-image: radial-gradient(circle at 50% 46%, #000 0 54%, transparent 86%);
      opacity: calc(0.42 + var(--audio-level) * 0.22);
      animation: oracle-grid-drift 18s linear infinite;
    }
    .oracle-stage::after {
      inset: -12%;
      background: linear-gradient(112deg, transparent 24%, rgba(245, 242, 255, calc(0.04 + var(--audio-air) * 0.13)) 42%, transparent 58%);
      opacity: 0.72;
      transform: translateX(-30%) rotate(-3deg);
      animation: oracle-sheen 8s ease-in-out infinite;
    }
    .oracle-stage > * {
      position: relative;
      z-index: 1;
    }
    .oracle-action-stack {
      display: grid;
      gap: 10px;
      width: min(760px, 100%);
      margin-top: 2px;
    }
    .oracle-handsfree-card,
    .oracle-voice-banner {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      flex-wrap: wrap;
      text-align: left;
      padding: 12px 14px;
      border: 1px solid rgba(148, 163, 184, 0.26);
      border-radius: 10px;
      background: rgba(6, 8, 18, 0.72);
      box-shadow: inset 0 1px 0 rgba(245, 242, 255, 0.05);
    }
    .oracle-handsfree-card[hidden],
    .oracle-voice-banner[hidden] { display: none !important; }
    .oracle-action-copy {
      display: grid;
      gap: 2px;
      min-width: 220px;
      flex: 1;
    }
    .oracle-action-copy strong { font-size: 13px; }
    .oracle-action-copy small { color: #a5a5be; font-size: 11px; }
    .oracle-action-buttons { display: flex; gap: 8px; flex-wrap: wrap; }
    .oracle-voice-banner {
      border-color: rgba(245, 158, 11, 0.48);
      background: rgba(245, 158, 11, 0.10);
    }
    .oracle-stage[data-presence="listening"] {
      --audio-level: 0.44;
      --audio-voice: 0.18;
      --audio-air: 0.58;
      --cell-audio: 0.42;
      --link-audio: 0.32;
    }
    .oracle-stage[data-presence="thinking"] {
      --mirror-c-rgb: 96, 165, 250;
      --audio-level: 0.36;
      --audio-voice: 0.16;
      --audio-air: 0.36;
      --cell-audio: 0.44;
      --link-audio: 0.44;
    }
    .oracle-stage[data-presence="speaking"] {
      --audio-level: 0.94;
      --audio-voice: 0.88;
      --audio-air: 0.74;
      --cell-audio: 0.86;
      --link-audio: 0.58;
    }
    .oracle-stage[data-presence="blocked"],
    .oracle-stage[data-presence="error"] {
      --mirror-a-rgb: 245, 158, 11;
      --mirror-b-rgb: 248, 113, 113;
      --audio-level: 0.46;
      --audio-voice: 0.18;
      --audio-air: 0.20;
    }
    .oracle-mirror-cell {
      position: relative;
      width: min(680px, 100%);
      height: clamp(330px, 48vh, 500px);
      min-height: 300px;
      border: 1px solid rgba(245, 242, 255, 0.10);
      border-radius: 18px;
      overflow: hidden;
      background:
        radial-gradient(58% 50% at 50% 43%, rgba(245, 242, 255, 0.07), transparent 68%),
        radial-gradient(78% 72% at 50% 42%, rgba(var(--mirror-a-rgb), 0.22), transparent 74%),
        radial-gradient(78% 66% at 50% 68%, rgba(var(--mirror-b-rgb), 0.055), transparent 78%),
        linear-gradient(180deg, rgba(245, 242, 255, 0.055), rgba(245, 242, 255, 0.014)),
        rgba(3, 2, 6, 0.94);
      box-shadow:
        0 34px 88px rgba(0, 0, 0, 0.54),
        0 0 76px rgba(var(--mirror-a-rgb), 0.13),
        inset 0 1px 0 rgba(255, 255, 255, 0.09),
        inset 0 0 0 1px rgba(245, 242, 255, 0.04);
    }
    .oracle-mirror-cell::before {
      content: "";
      position: absolute;
      inset: -14%;
      background:
        radial-gradient(circle at 50% 45%, rgba(var(--mirror-a-rgb), 0.18), transparent 44%),
        radial-gradient(circle at 50% 64%, rgba(var(--mirror-b-rgb), 0.10), transparent 54%);
      opacity: calc(0.36 + var(--audio-level) * 0.26);
      filter: blur(18px);
      pointer-events: none;
    }
    .oracle-mirror-cell::after {
      content: "";
      position: absolute;
      inset: 7px;
      border-radius: inherit;
      box-shadow:
        inset 0 0 34px rgba(var(--mirror-a-rgb), 0.12),
        inset 0 0 90px rgba(0, 0, 0, 0.42),
        0 0 38px rgba(var(--mirror-a-rgb), 0.12);
      pointer-events: none;
    }
    .oracle-mirror-cell .mirror-glass {
      position: absolute;
      inset: 0;
      display: grid;
      place-items: center;
    }
    .oracle-mirror-cell .mirror-svg {
      width: min(560px, 92%);
      height: auto;
      filter: saturate(1.14) contrast(1.05);
      transform: translateY(-2px);
    }
    .oracle-mirror-cell .mirror-aura {
      fill: none;
      stroke: rgba(var(--mirror-a-rgb), 0.18);
      stroke-width: 1.2;
      stroke-dasharray: 5 18;
      opacity: calc(0.34 + var(--audio-air) * 0.30);
      transform-origin: center;
      animation: oracle-breathe 5s ease-in-out infinite;
    }
    .oracle-mirror-cell .mirror-core {
      fill: url(#ms4OracleMirrorCore);
      stroke: rgba(245, 242, 255, 0.08);
      opacity: 0.86;
    }
    .oracle-mirror-cell .mirror-face-energy {
      fill: rgba(var(--mirror-a-rgb), 0.04);
      stroke: rgba(var(--mirror-a-rgb), 0.18);
      stroke-width: 1.35;
      opacity: calc(0.18 + var(--audio-voice) * 0.34);
      transform-origin: center;
      animation: oracle-face-energy 4.8s ease-in-out infinite;
    }
    .oracle-mirror-cell .mirror-cell-link {
      stroke: rgba(var(--mirror-a-rgb), 0.14);
      stroke-width: 0.58;
      opacity: var(--link-audio);
    }
    .oracle-mirror-cell .mirror-cell-link.is-backdrop {
      stroke: rgba(245, 242, 255, 0.05);
      opacity: 0.10;
    }
    .oracle-mirror-cell .mirror-cell {
      fill: rgba(4, 4, 8, 0.16);
      stroke: rgba(245, 242, 255, 0.09);
      stroke-width: 0.68;
      opacity: 0.28;
      transform-box: fill-box;
      transform-origin: center;
    }
    .oracle-mirror-cell .mirror-cell.is-active {
      fill: rgba(var(--mirror-a-rgb), 0.075);
      stroke: rgba(var(--mirror-a-rgb), 0.48);
      stroke-width: 1.25;
      opacity: clamp(0.42, calc(0.34 + var(--cell-audio) * 0.72), 0.95);
      filter: drop-shadow(0 0 7px rgba(var(--mirror-a-rgb), 0.20));
      animation: oracle-cell-wake 4.4s ease-in-out infinite;
      animation-delay: calc(var(--i) * -74ms);
    }
    .oracle-stage[data-presence="idle"] .mirror-cell.is-active:not(.shape-eye) {
      opacity: clamp(0.32, calc(0.28 + var(--cell-audio) * 0.38), 0.58);
      animation-duration: 6.6s;
    }
    .oracle-mirror-cell .mirror-cell.shape-eye.is-active {
      fill: rgba(var(--mirror-b-rgb), 0.12);
      stroke: rgba(var(--mirror-b-rgb), 0.86);
      stroke-width: 1.8;
      opacity: 1;
      filter: drop-shadow(0 0 9px rgba(var(--mirror-b-rgb), 0.34));
    }
    .oracle-mirror-cell .mirror-cell.is-status {
      fill: rgba(var(--mirror-b-rgb), 0.24);
      stroke: rgba(var(--mirror-b-rgb), 0.96);
      stroke-width: 2.4;
      opacity: 0.98;
      animation: oracle-status-cell 2.8s ease-in-out infinite;
      filter:
        drop-shadow(0 0 6px rgba(var(--mirror-b-rgb), 0.45))
        drop-shadow(0 0 14px rgba(var(--mirror-b-rgb), 0.28));
    }
    .oracle-mirror-cell .mirror-face-outline {
      fill: none;
      stroke: rgba(245, 242, 255, 0.24);
      stroke-width: 1.15;
      opacity: 0.48;
    }
    .oracle-mirror-cell .mirror-eyes polygon {
      fill: rgba(var(--mirror-b-rgb), 0.10);
      stroke: rgba(var(--mirror-b-rgb), 0.62);
      stroke-width: 1.2;
      opacity: 0.92;
    }
    .oracle-mirror-cell .mirror-eyes circle {
      fill: rgba(245, 242, 255, 0.80);
      opacity: calc(0.68 + var(--audio-air) * 0.24);
      filter: drop-shadow(0 0 10px rgba(var(--mirror-b-rgb), 0.38));
    }
    .oracle-mirror-cell .mirror-eye-rings polygon {
      fill: none;
      opacity: 0.64;
      stroke: rgba(var(--mirror-b-rgb), 0.36);
    }
    .oracle-mirror-cell .mirror-speaking-bars {
      opacity: 0.035;
      transform-origin: center;
      filter: drop-shadow(0 0 8px rgba(var(--mirror-a-rgb), 0.12));
    }
    .oracle-mirror-cell .mirror-speaking-bar {
      transform-box: fill-box;
      transform-origin: center;
    }
    .oracle-mirror-cell .mirror-speaking-cell {
      fill: rgba(var(--mirror-a-rgb), 0.18);
      stroke: rgba(var(--mirror-a-rgb), 0.34);
      stroke-width: 0.36;
      opacity: calc(0.02 + var(--audio-opacity, 0.02) * 0.42);
      transform-box: fill-box;
      transform-origin: center;
      transform: translateY(calc(var(--cell-row-offset, 0) * var(--audio-scale, 0) * 0.55px)) scale(calc(0.82 + var(--audio-scale, 0) * 0.16));
      transition:
        opacity 76ms linear,
        transform 76ms linear;
    }
    .oracle-mirror-cell .mirror-wave {
      opacity: 0.035;
      transform-origin: center;
      filter: drop-shadow(0 0 5px rgba(var(--mirror-a-rgb), 0.10));
    }
    .oracle-mirror-cell .mirror-wave-cell {
      fill: rgba(var(--mirror-c-rgb), 0.20);
      stroke: rgba(var(--mirror-c-rgb), 0.40);
      stroke-width: 0.38;
      opacity: 0.20;
      transform-box: fill-box;
      transform-origin: center;
    }
    .oracle-stage[data-presence="speaking"] .mirror-speaking-bars,
    .oracle-stage[data-presence="speaking"] .mirror-wave,
    .oracle-stage[data-presence="listening"] .mirror-wave {
      opacity: 0.78;
    }
    .oracle-stage[data-presence="speaking"] .mirror-speaking-cell {
      stroke: rgba(245, 255, 235, 0.88);
      stroke-width: 0.44;
      opacity: calc(0.56 + var(--audio-scale, 0.13) * 0.36);
      transform: translateY(calc(var(--cell-row-offset, 0) * var(--audio-scale, 0.13) * 1.35px)) scale(calc(0.98 + var(--audio-scale, 0.13) * 0.16));
    }
    .oracle-stage[data-presence="speaking"] .mirror-wave-cell,
    .oracle-stage[data-presence="listening"] .mirror-wave-cell {
      opacity: clamp(0.26, calc(0.18 + var(--audio-air) * 0.72), 0.96);
      animation: oracle-wave-talk 1.7s ease-in-out infinite;
      animation-delay: calc(var(--i) * -36ms);
    }
    .oracle-console {
      display: flex;
      width: min(720px, 100%);
      min-width: 0;
      flex-direction: column;
      gap: 10px;
      align-items: center;
      justify-content: center;
    }
    .oracle-kicker {
      display: none;
      color: #93e6d4;
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0;
      text-transform: uppercase;
    }
    .oracle-title {
      margin: 0;
      font-size: 34px;
      line-height: 1.06;
      font-weight: 720;
    }
    .oracle-subtitle {
      max-width: 680px;
      min-height: 36px;
      color: #f7f7ff;
      font-size: 17px;
      line-height: 1.34;
      overflow-wrap: anywhere;
    }
    .oracle-transcript,
    .oracle-timing,
    .oracle-lobes {
      min-height: 22px;
      color: #aab4c5;
      font-size: 12px;
      line-height: 1.38;
      overflow-wrap: anywhere;
    }
    .oracle-transcript:empty,
    .oracle-timing:empty,
    .oracle-lobes:empty {
      display: none;
    }
    .oracle-status-row {
      display: flex;
      gap: 8px;
      flex-wrap: wrap;
      align-items: center;
      justify-content: center;
    }
    .oracle-state-chip {
      min-height: 30px;
      display: inline-flex;
      align-items: center;
      border-radius: 999px;
      border: 1px solid rgba(148, 163, 184, 0.28);
      background: rgba(8, 12, 18, 0.62);
      color: #d8e4ee;
      font-size: 12px;
      padding: 0 10px;
      white-space: nowrap;
    }
    .oracle-state-chip strong {
      color: #f6fbff;
      font-weight: 650;
    }
    @media (max-width: 800px) {
      .oracle-stage {
        grid-template-columns: 1fr;
        min-height: calc(100vh - 120px);
      }
      .oracle-mirror-cell {
        height: clamp(300px, 78vw, 390px);
      }
      .oracle-title {
        font-size: 28px;
      }
    }
    @keyframes oracle-breathe {
      0%, 100% { opacity: 0.34; transform: scale(0.98); }
      50% { opacity: 0.72; transform: scale(1.025); }
    }
    @keyframes oracle-face-energy {
      0%, 100% { opacity: 0.18; transform: scale(0.992); }
      46% { opacity: 0.46; transform: scale(1.012); }
      68% { opacity: 0.30; transform: scale(1.002); }
    }
    @keyframes oracle-cell-wake {
      0%, 100% { opacity: 0.36; transform: scale(0.986); }
      48% { opacity: 0.88; transform: scale(1.024); }
    }
    @keyframes oracle-speaking-meter {
      0%, 100% { opacity: 0.28; transform: scaleY(0.52); }
      28% { opacity: 0.88; transform: scaleY(1.08); }
      58% { opacity: 0.48; transform: scaleY(0.68); }
      78% { opacity: 0.94; transform: scaleY(0.92); }
    }
    @keyframes oracle-wave-talk {
      0%, 100% { transform: translateY(0) scale(0.98); }
      50% { transform: translateY(-3px) scale(1.08); }
    }
    @keyframes oracle-status-cell {
      0%, 100% { opacity: 0.82; transform: scale(1.04); }
      45%, 62% { opacity: 1; transform: scale(1.16); }
    }
    @keyframes oracle-grid-drift {
      to { background-position: 46px 46px, 46px 46px, 0 0; }
    }
    @keyframes oracle-sheen {
      0%, 100% { opacity: 0.18; transform: translateX(-30%) rotate(-3deg); }
      48%, 54% { opacity: 0.42; transform: translateX(26%) rotate(-3deg); }
    }
    .version-line { display: flex; align-items: center; gap: 6px; flex-wrap: wrap; }
    .version-line .pill { padding: 1px 6px; border-radius: 8px; background: #1d1d2d; border: 1px solid #33334a; font-size: 11px; }
    .version-line .pill.warn { background: rgba(245, 158, 11, 0.18); border-color: rgba(245, 158, 11, 0.5); color: #f5e7c2; }
    .version-line .pill.ok { background: rgba(34, 197, 94, 0.15); border-color: rgba(34, 197, 94, 0.4); color: #c8f3d2; }
    dialog { background: #121221; color: #e6e6f0; border: 1px solid #33334a; border-radius: 12px; padding: 18px; max-width: 460px; }
    dialog::backdrop { background: rgba(0,0,0,0.55); }
    dialog h3 { margin: 0 0 6px 0; font-size: 16px; }
    dialog .row { display: flex; gap: 8px; margin-top: 12px; justify-content: flex-end; }
    dialog select { width: 100%; }
  </style>
</head>
<body>
<main id="appRoot" class="oracle-front-door">
  <header>
    <div>
      <h1>║ MS4 Fusion Runtime</h1>
      <div class="muted">Hermes turn loop + MS3 identity/ethics + HiveMind substrate</div>
    </div>
    <div id="status" class="muted">connecting...</div>
  </header>

  <div id="hermesUpdateBanner" class="banner" role="status" aria-live="polite">
    <span class="warn" aria-hidden="true">⚠</span>
    <div class="text">
      <strong id="hermesUpdateHeadline">Checking for Hermes updates…</strong>
      <small id="hermesUpdateSubline"></small>
    </div>
    <div style="display:flex; gap:8px; align-items:center;">
      <button id="hermesUpdatePinBtn" class="secondary" type="button" title="Pin a specific Hermes version">Pin version…</button>
      <button id="hermesUpdateBtn" type="button">Update Hermes</button>
