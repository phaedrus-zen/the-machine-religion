const settingsOracleStatus = document.getElementById('settingsOracleStatus');

function renderOracleReadiness(data) {
  const lines = [];
  const checks = Array.isArray(data.checks) ? data.checks : [];
  const blockers = Array.isArray(data.blockers) ? data.blockers : [];
  const actions = Array.isArray(data.next_actions) ? data.next_actions : [];
  const provisioning = data.provisioning || {};
  lines.push(`readiness   = ${data.readiness || (data.ready ? 'ready' : 'unknown')}`);
  lines.push(`auth        = ${data.auth_configured ? 'configured' : 'not configured'}`);
  if (data.mcp_base_url) lines.push(`mcp         = ${data.mcp_base_url}`);
  lines.push(`provision   = ${provisioning.automatic ? 'automatic' : (provisioning.state || 'approval_required')}`);
  if (checks.length) {
    lines.push('');
    lines.push('checks');
    for (const check of checks.slice(0, 8)) {
      lines.push(`  ${check.name || 'check'}: ${check.state || 'unknown'}${check.detail ? ' - ' + check.detail : ''}`);
    }
  }
  if (blockers.length) {
    lines.push('');
    lines.push('blockers');
    for (const blocker of blockers.slice(0, 8)) lines.push(`  - ${blocker}`);
  }
  if (actions.length) {
    lines.push('');
    lines.push('next');
    for (const action of actions.slice(0, 5)) {
      const approval = action.requires_approval ? 'approval required' : 'safe';
      lines.push(`  - ${action.label || 'action'} (${approval})`);
    }
  }

  settingsHivemindOracle.innerHTML = '';
  const pre = document.createElement('pre');
  pre.style.cssText = 'margin:0; white-space:pre-wrap; background:#0e0f17; padding:6px; border-radius:6px; border:1px solid #2d2d44; font-size:11px;';
  pre.textContent = lines.join('\n');
  settingsHivemindOracle.appendChild(pre);

  const details = document.createElement('details');
  details.style.cssText = 'margin-top:6px;';
  const summary = document.createElement('summary');
  summary.style.cssText = 'cursor:pointer; color:#9999b4; font-size:11px;';
  summary.textContent = 'Raw readiness snapshot';
  const raw = document.createElement('pre');
  raw.style.cssText = 'margin:6px 0 0; max-height:260px; overflow:auto; white-space:pre-wrap; background:#0e0f17; padding:6px; border-radius:6px; border:1px solid #2d2d44; font-size:11px;';
  raw.textContent = JSON.stringify(data, null, 2).slice(0, 6000);
  details.appendChild(summary);
  details.appendChild(raw);
  settingsHivemindOracle.appendChild(details);
}

async function refreshHivemindOracle() {
  if (!settingsHivemindOracle) return;
  settingsHivemindOracle.textContent = 'Loading…';
  try {
    if (settingsOracleReadinessStatus) settingsOracleReadinessStatus.textContent = 'Refreshing...';
    const r = await fetch('/hivemind/oracle/readiness', {cache: 'no-store'});
    if (!r.ok) throw new Error(`HTTP ${r.status}: ${await r.text()}`);
    const data = await r.json();
    renderOracleReadiness(data);
    if (settingsOracleReadinessStatus) {
      settingsOracleReadinessStatus.textContent = `state=${data.readiness || 'unknown'}`;
    }
  } catch (exc) {
    settingsHivemindOracle.textContent = `/hivemind/oracle/readiness failed: ${exc.message || exc}`;
    if (settingsOracleReadinessStatus) settingsOracleReadinessStatus.textContent = 'failed';
  }
}

async function askOracle() {
